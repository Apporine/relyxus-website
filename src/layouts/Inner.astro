---
// Inner page shell: the approved design file for the page, with the navbar
// placed inside its first section exactly as in the designs, then the footer.
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { page, fit } from "../lib/pages";
import kit from "../styles/kit.css?raw";
import "../styles/kit-live.css";
const kitCss = fit(kit);
interface Props { slug: string; description: string; path: string }
const { slug, description, path } = Astro.props;
const p = page(slug);
---
<Base title={p.title} description={description} path={path} bodyClass="inner">
  <style is:inline set:html={kitCss}></style>
  <main id="main" class="pgm">
    <Fragment set:html={p.head} />
    <Nav />
    <Fragment set:html={p.rest} />
  </main>
  <Footer />
</Base>
<script>
import { wire } from "../scripts/inner";
wire();
</script>
