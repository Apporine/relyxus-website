# Optional: preferred email delivery via Resend (https://resend.com)
# Without this key, enquiries fall back to FormSubmit (first activation email goes to aoon.syed@apporine.com).
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Relyxus Website <onboarding@resend.dev>

# Optional: booking page (Calendly, Cal.com, HubSpot...) shown after the demo form.
