---
import Page from "../../layouts/Page.astro";
import Spotlight from "../../components/home/Spotlight.astro";
import { articles } from "../../data/articles";
const topics = ["All", "Regulation", "Vigil and AI", "Audit", "Security"];
---
<Page title="Articles | Relyxus" description="Guides on incident response, regulator reporting and resilience, written by the people building Relyxus." path="/articles" tone="light" current="/articles">
  <Spotlight />
  <section class="k-sec k-mist ar-grid"><div class="wrap"><div class="fil">{topics.map((t, i) => <button class={i === 0 ? "on" : ""}>{t}</button>)}</div>
    <div class="k-g3" style="margin-top:24px">{articles.map((a) => <a class="k-card c" href={a.ready ? `/articles/${a.slug}` : "#"} style={`--c:${a.colour};--b:${a.b}`}><div class="top"></div><span class="tp">{a.topic}</span><b>{a.title}</b><small>{a.ready ? a.read : "Publishing soon"}</small></a>)}</div></div></section>
</Page>
<style is:global>
.ar-grid .fil{display:flex;gap:8px;flex-wrap:wrap}.ar-grid .fil button{border:1px solid var(--line);background:#fff;border-radius:999px;padding:9px 15px;font-size:14.5px;cursor:pointer}.ar-grid .fil button.on{background:#0A0C10;color:#fff;border-color:#0A0C10}
.ar-grid .c{display:flex;flex-direction:column;gap:8px;padding:0 0 20px;overflow:hidden;transition:transform .3s}.ar-grid .c:hover{transform:translateY(-4px)}
.ar-grid .top{height:120px;background:radial-gradient(70% 90% at 30% 20%,var(--b),transparent),radial-gradient(60% 80% at 90% 100%,var(--c),transparent),#F6F8FA;margin-bottom:8px}
.ar-grid .tp,.ar-grid .c b,.ar-grid .c small{padding:0 20px}.ar-grid .tp{font-size:13px;font-weight:600;color:var(--c)}.ar-grid .c b{font-size:19px;line-height:1.3}.ar-grid .c small{color:var(--muted)}
</style>
