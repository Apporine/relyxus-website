# Vigil, the website assistant. All three are optional; with none set, Vigil
# answers from its built in knowledge and sends nothing anywhere.
# Set them in Vercel: Project, Settings, Environment Variables. See agent/README.md.

# Google Apps Script web app that saves leads and chats to a Google Sheet
PUBLIC_VIGIL_LEADS_URL=
# Cloudflare Worker that answers questions the built in knowledge does not cover
PUBLIC_VIGIL_AI_URL=
# Booking page, for example a Google Calendar appointment schedule
PUBLIC_VIGIL_BOOKING_URL=/demo#book
