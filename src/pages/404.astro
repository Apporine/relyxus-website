---
import Base from "../layouts/Base.astro";
import Wordmark from "../components/Wordmark.astro";
import Footer from "../components/Footer.astro";
---
<Base title="Page not found | Relyxus" description="This page does not exist yet or has moved.">
  <main id="main" class="r-404">
    <header class="wrap top"><a href="/" aria-label="Relyxus home"><Wordmark id="wm-404" color="#fff" width={92} /></a></header>
    <div class="wrap body">
      <p class="code">404</p>
      <h1>This page went down.<br /><span>Bringing you back.</span></h1>
      <p class="sub">The page you asked for does not exist yet, or it has moved. Most of the site is still being built, so it may arrive soon.</p>
      <div class="line" aria-hidden="true"><canvas></canvas></div>
      <div class="cta"><a class="b1" href="/">Back to the homepage</a><a class="b2" href="/demo#book">Book a demo</a></div>
    </div>
  </main>
  <Footer />
</Base>
<style is:global>
.r-404{background:#05070C;color:#fff;min-height:80vh;position:relative;overflow:hidden}
.r-404 .top{padding-top:28px;padding-bottom:28px}
.r-404 .body{padding-top:60px;padding-bottom:90px}
.r-404 .code{font-size:14px;font-weight:600;color:#FF8A66;margin:0}
.r-404 h1{font-family:var(--display);font-variation-settings:'opsz' 96;font-weight:500;letter-spacing:-.04em;line-height:1.02;font-size:clamp(44px,7vw,92px);margin:12px 0 0}
.r-404 h1 span{color:#8BE6BE}
.r-404 .sub{font-size:18px;line-height:1.55;color:#C9D1DC;max-width:560px;margin:20px 0 0}
.r-404 .line{height:120px;margin:28px 0 8px}.r-404 .line canvas{width:100%;height:100%;display:block}
.r-404 .cta{display:flex;gap:10px;flex-wrap:wrap}
.r-404 .b1{background:#fff;color:#05070C;border-radius:999px;padding:12px 20px;font-weight:600}
.r-404 .b2{border:1px solid #3A4458;border-radius:999px;padding:11px 19px;font-weight:500}
</style>
<script>
const cv = document.querySelector<HTMLCanvasElement>(".r-404 canvas")!, x = cv.getContext("2d")!;
const h = (n: number) => { const s = Math.sin(n * 127.1) * 43758.5; return s - Math.floor(s); };
function draw(t: number) { const D = Math.min(2, devicePixelRatio || 1), w = cv.clientWidth, H = cv.clientHeight; if (cv.width !== w * D) { cv.width = w * D; cv.height = H * D; }
  x.setTransform(D, 0, 0, D, 0, 0); x.clearRect(0, 0, w, H); const calmAt = 0.35 + 0.3 * (0.5 + 0.5 * Math.sin(t * 0.4));
  for (let L = 0; L < 3; L++) { x.beginPath(); for (let px = 0; px <= w; px += 3) { const u = px / w, calm = Math.min(1, Math.max(0, (u - calmAt) / 0.15)), g = h(Math.floor(u * 40) + Math.floor(t * 3)) > 0.8 ? 1 : 0;
    const y = H / 2 + (Math.sin(u * 30 + t * 3 + L) * 18 + g * (h(px + L) - 0.5) * 60) * (1 - calm) + Math.sin(u * 6 + t + L) * 3 * calm; px ? x.lineTo(px, y) : x.moveTo(px, y); }
    const gr = x.createLinearGradient(0, 0, w, 0); gr.addColorStop(0, "#FF6B4A"); gr.addColorStop(calmAt, "#9FB4D6"); gr.addColorStop(1, "#3DAE80");
    x.strokeStyle = gr; x.globalAlpha = L ? 0.35 : 1; x.lineWidth = L ? 1.5 : 2.5; x.stroke(); x.globalAlpha = 1; } }
if (matchMedia("(prefers-reduced-motion: reduce)").matches) draw(2); else { const loop = (ts: number) => { draw(ts / 1000); requestAnimationFrame(loop); }; requestAnimationFrame(loop); }
</script>
