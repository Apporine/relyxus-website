---
import Page from "../layouts/Page.astro";
---
<Page title="About and contact | Relyxus" description="Who builds Relyxus, why, and how to reach a person." path="/about" tone="dark" current="">
  <section class="k-sec k-dark ab-hero"><div class="wrap"><p class="typed">We built the tool we wished we had at 3am.<i></i></p></div></section>
  <section class="k-sec k-navy ab-why"><div class="wrap k-split"><div><h2 class="k-h2">The best come back first.</h2><p class="k-lede">Every bank goes down. The ones customers trust are the ones that know what broke, fix it safely and say so honestly. Relyxus exists to make that the normal way an outage goes.</p></div><canvas class="wv" aria-hidden="true"></canvas></div></section>
  <section class="k-sec k-white ab-ppl"><div class="wrap"><h2 class="k-h2">The people you will <span>actually talk to.</span></h2><div class="k-g2" style="margin-top:40px">{[["Bisma Idrees", "CEO and Co-founder", "BI"], ["Aoon Syed", "CEO and Co-founder", "AS"]].map(([n, r, i]) => <div class="k-card p"><span class="av">{i}</span><div><b>{n}</b><small>{r}, Apporine</small></div><a class="k-b2" href="/demo#book">Talk to {n.split(" ")[0]}</a></div>)}</div></div></section>
  <section class="k-sec k-mist ab-ct"><div class="wrap"><h2 class="k-h2">A person answers.</h2><div class="k-g3" style="margin-top:40px">{[["Sales", "Book a demo or ask about pricing", "/demo#book"], ["Security", "Report a vulnerability or request documents", "/trust#disclosure"], ["Support", "For customers running Relyxus", "/demo#book"]].map(([t, d, h]) => <a class="k-card c" href={h}><b>{t}</b><span>{d}</span><i class="ti ti-arrow-right"></i></a>)}</div></div></section>
</Page>
<style is:global>
.ab-hero{padding:160px 0;min-height:60vh;display:flex;align-items:center}
.ab-hero .typed{font-family:var(--display);font-variation-settings:'opsz' 96;font-weight:500;font-size:clamp(40px,6vw,88px);letter-spacing:-.04em;line-height:1.05;margin:0;max-width:1000px}
.ab-hero .typed i{display:inline-block;width:6px;height:.9em;background:#FF6B4A;margin-left:8px;vertical-align:-.08em;animation:vg-caret 1s steps(1) infinite}
.ab-why .wv{width:100%;height:280px}
.ab-ppl .p{padding:24px;display:grid;grid-template-columns:64px 1fr auto;gap:16px;align-items:center}.ab-ppl .av{width:64px;height:64px;border-radius:50%;background:#0A0C10;color:#fff;display:grid;place-items:center;font-weight:600;font-size:20px}.ab-ppl .p b{font-size:20px}.ab-ppl .p small{display:block;color:var(--muted)}
.ab-ct .c{padding:24px;display:flex;flex-direction:column;gap:8px;position:relative}.ab-ct .c b{font-size:22px}.ab-ct .c span{color:var(--muted)}.ab-ct .c i{position:absolute;right:22px;top:24px;font-size:22px}
</style>
<script>
const cv = document.querySelector<HTMLCanvasElement>(".ab-why .wv")!, x = cv.getContext("2d")!;
function draw(t: number) { const D = Math.min(2, devicePixelRatio || 1), w = cv.clientWidth, h = cv.clientHeight; if (cv.width !== w * D) { cv.width = w * D; cv.height = h * D; } x.setTransform(D, 0, 0, D, 0, 0); x.clearRect(0, 0, w, h);
  for (let i = 0; i < 24; i++) { const u = i / 24; x.beginPath(); for (let px = 0; px <= w; px += 4) { const s = px / w, calm = Math.min(1, s * 1.4), y = h / 2 + Math.sin(s * 8 + t * 0.4 + u * 3) * h * 0.3 * (1 - calm * 0.85) * Math.sin(Math.PI * s) + (u - 0.5) * 60 * (1 - calm); px ? x.lineTo(px, y) : x.moveTo(px, y); }
    x.strokeStyle = `rgba(${Math.round(255 - 194 * u)},${Math.round(107 + 67 * u)},${Math.round(74 + 54 * u)},.35)`; x.stroke(); } }
if (matchMedia("(prefers-reduced-motion: reduce)").matches) draw(2); else { const l = (ts: number) => { draw(ts / 1000); requestAnimationFrame(l); }; requestAnimationFrame(l); }
</script>
