---
import Page from "../layouts/Page.astro";
const flows = [["Incident data", "Stays in your account", "None"], ["Alerts and logs", "Read in place by connectors", "None"], ["Vigil prompts", "Your chosen model route, your region", "None"], ["Audit log", "Written to your own storage", "None"], ["Licence check", "A signed file, checked offline", "None"], ["Product updates", "You pull them, when you approve", "None"]];
const steps = [["$ relyxus-kit init --cloud aws --region eu-west-2", "Account, network and keys checked"], ["$ relyxus-kit plan", "Plan written for your change board to review"], ["$ relyxus-kit apply", "Cluster, database and storage created in your account"], ["$ relyxus-kit connect prometheus slack servicenow", "Read only connectors added"], ["$ relyxus-kit verify", "46 of 46 security checks passed"]];
---
<Page title="Deployment | Relyxus" description="Relyxus runs inside your own cloud, on AWS, Azure or air gapped. Nothing comes back to us." path="/deployment" tone="dark">
  <section class="k-sec k-dark dp-hero">
    <div class="wrap k-split">
      <div>
        <span class="k-tag"><i class="d"></i>Deployment</span>
        <h1 class="k-h1" style="margin-top:16px">It runs in your cloud.<br /><span>Nothing comes back to us.</span></h1>
        <p class="k-lede">Relyxus is not a service you send your incidents to. It is software you install in your own account, behind your own network rules, with your own keys. We never see your data.</p>
        <div class="k-btns"><a class="k-b3" href="/demo#book">Talk to an architect</a><a class="k-b2" href="/trust">See the security pack</a></div>
      </div>
      <div class="iso" aria-hidden="true">
        <div class="plane p1"><span>Your cloud account</span></div>
        <div class="plane p2"><span>Your network</span></div>
        <div class="plane p3"><b>Relyxus</b><i></i><i></i><i></i></div>
        <div class="ring"></div>
        <div class="out"><span class="arrow"></span><span class="x">Nothing leaves</span></div>
      </div>
    </div>
  </section>

  <section class="k-sec k-white dp-where">
    <div class="wrap">
      <h2 class="k-h2">AWS, Azure, <span>or no internet at all.</span></h2>
      <div class="targets">
        <div class="t on" style="--c:#FF9900"><b>AWS</b><span>EKS, RDS and S3 in your account</span></div>
        <div class="t" style="--c:#0078D4"><b>Azure</b><span>AKS, Azure Database and Blob Storage</span></div>
                <div class="t" style="--c:#9FB4D6"><b>Air gapped</b><span>No internet. Updates arrive on signed media</span></div>
      </div>
      <div class="scene"><div class="rack"><span></span><span></span><span></span><span></span></div><div class="cable"><i></i></div><div class="cloud"><i class="ti ti-cloud-off"></i><b>Air gapped mode</b><small>Vigil runs on a model inside your network</small></div></div>
    </div>
  </section>

  <section class="k-sec k-navy dp-term">
    <div class="wrap k-split">
      <div>
        <h2 class="k-h2">One installation kit. <span>Your engineers stay in control.</span></h2>
        <p class="k-lede">The kit is plain Terraform and Helm your team can read line by line. It plans first, so your change board approves the exact changes before anything is created.</p>
      </div>
      <div class="term k-card"><div class="tb"><i></i><i></i><i></i><span>relyxus-kit, payments-uk</span></div>
        {steps.map(([c, r], i) => <div class="ln" style={`animation-delay:${i * 0.9}s`}><code>{c}</code><span><i class="ti ti-circle-check"></i>{r}</span></div>)}
      </div>
    </div>
  </section>

  <section class="k-sec k-white dp-ledger">
    <div class="wrap">
      <h2 class="k-h2">What leaves your network: <span>nothing you did not approve.</span></h2>
      <div class="led k-card" role="table" aria-label="Data flows">
        <div class="hd" role="row"><span>Data</span><span>Where it lives</span><span>Sent to Relyxus</span></div>
        {flows.map(([a, b, c], i) => <div class="r" role="row" style={`animation-delay:${i * 0.5}s`}><span><b>{a}</b></span><span>{b}</span><span class="v">{c}</span></div>)}
      </div>
    </div>
  </section>

  <section class="k-sec k-mist dp-keys">
    <div class="wrap">
      <h2 class="k-h2">Your keys. Your region. <span>Your audit log.</span></h2>
      <div class="keys">
        <div class="key" style="--c:#FF6B4A"><i class="ti ti-key"></i><b>Customer managed keys</b><p>Encryption keys live in your KMS or HSM. Revoke them and Relyxus stops, by design.</p></div>
        <div class="key" style="--c:#7FA0D6"><i class="ti ti-map-pin"></i><b>Data residency</b><p>Pick the region at install. Data, backups and model calls stay there.</p></div>
        <div class="key" style="--c:#3DAE80"><i class="ti ti-file-certificate"></i><b>Your audit log</b><p>Every action, approval and AI answer, written to storage you own and can export.</p></div>
      </div>
    </div>
  </section>

  <section class="k-sec k-dark dp-size">
    <div class="wrap k-split">
      <div>
        <h2 class="k-h2">Sized to your bank.</h2>
        <p class="k-lede">From one team on call to a group with many entities. The sizing guide shows the cluster, database and storage for each size, measured in our own load tests.</p>
        <div class="k-btns"><a class="k-b3" href="/demo#book">Get the sizing guide</a></div>
        <p class="k-note">The guide is finalised after our production size load test.</p>
      </div>
      <div class="stack" aria-hidden="true"><span style="--d:0s"></span><span style="--d:.2s"></span><span style="--d:.4s"></span><span style="--d:.6s"></span><span style="--d:.8s"></span></div>
    </div>
  </section>
</Page>
<style is:global>
.dp-hero{padding:104px 0}
.dp-hero .iso{position:relative;height:440px;perspective:1200px}
.dp-hero .plane{position:absolute;left:50%;top:50%;border-radius:22px;transform:translate(-50%,-50%) rotateX(58deg) rotateZ(-38deg);display:flex;align-items:flex-start;justify-content:flex-start;padding:16px}
.dp-hero .plane span{font-size:13px;color:#C9D1DC;transform:rotateZ(0)}
.dp-hero .p1{width:420px;height:420px;background:rgba(127,160,214,.06);border:1px solid rgba(127,160,214,.35);margin-top:40px}
.dp-hero .p2{width:300px;height:300px;background:rgba(127,160,214,.1);border:1px dashed rgba(159,180,214,.6);margin-top:10px}
.dp-hero .p3{width:170px;height:170px;background:linear-gradient(140deg,#1A2333,#0B0F18);border:1px solid #3A4458;margin-top:-26px;box-shadow:0 0 60px rgba(61,174,128,.35);flex-direction:column;gap:8px}
.dp-hero .p3 b{font-size:16px}.dp-hero .p3 i{display:block;width:70%;height:8px;border-radius:4px;background:#3DAE80}.dp-hero .p3 i+i{background:#9FB4D6;width:50%}.dp-hero .p3 i+i+i{background:#FF8A66;width:60%}
.dp-hero .ring{position:absolute;left:50%;top:50%;width:250px;height:250px;margin:-150px 0 0 -125px;border-radius:50%;border:1px solid rgba(61,174,128,.5);animation:dp-pulse 3s ease-out infinite}
@keyframes dp-pulse{from{transform:scale(.7);opacity:1}to{transform:scale(1.5);opacity:0}}
.dp-hero .out{position:absolute;right:2%;top:16%;display:flex;align-items:center;gap:10px}
.dp-hero .out .arrow{width:110px;height:2px;background:repeating-linear-gradient(90deg,#FF8A66 0 8px,transparent 8px 14px);position:relative}
.dp-hero .out .arrow::after{content:"";position:absolute;left:44%;top:-11px;width:24px;height:24px;background:linear-gradient(45deg,transparent 45%,#FF6B4A 45% 55%,transparent 55%),linear-gradient(-45deg,transparent 45%,#FF6B4A 45% 55%,transparent 55%)}
.dp-hero .out .x{font-size:14px;font-weight:600;color:#FF8A66;border:1px solid rgba(255,107,74,.4);background:rgba(255,107,74,.1);border-radius:999px;padding:6px 12px}
.dp-where .targets{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:40px}
.dp-where .t{border:1px solid var(--line);border-radius:14px;padding:18px;cursor:pointer;transition:all .3s;position:relative;overflow:hidden}
.dp-where .t::before{content:"";position:absolute;left:0;right:0;top:0;height:3px;background:var(--c)}
.dp-where .t b{display:block;font-size:19px}.dp-where .t span{display:block;font-size:14.5px;color:var(--muted);margin-top:6px}
.dp-where .t:last-child{background:#0A0C10;color:#fff;border-color:#0A0C10}.dp-where .t:last-child span{color:#C9D1DC}
.dp-where .scene{margin-top:22px;height:250px;border-radius:18px;background:#0A0C10;display:flex;align-items:center;justify-content:center;gap:0;position:relative;overflow:hidden}
.dp-where .rack{display:flex;flex-direction:column;gap:8px;padding:18px;border:1px solid #2C3546;border-radius:12px;background:#111620}
.dp-where .rack span{display:block;width:160px;height:22px;border-radius:5px;background:linear-gradient(90deg,#1E2532 70%,#3DAE80 70% 74%,#1E2532 74%)}
.dp-where .cable{width:220px;height:2px;background:#3A4458;position:relative}
.dp-where .cable i{position:absolute;left:46%;top:-14px;width:30px;height:30px;border-radius:6px;border:2px solid #FF8A66;animation:dp-unplug 2.4s ease-in-out infinite alternate}
@keyframes dp-unplug{to{transform:translate(40px,30px) rotate(25deg);opacity:.4}}
.dp-where .cloud{display:flex;flex-direction:column;align-items:center;gap:4px;color:#fff;padding:20px 26px;border:1px dashed #3A4458;border-radius:14px}
.dp-where .cloud i{font-size:34px;color:#9FB4D6}.dp-where .cloud small{color:#C9D1DC;font-size:13.5px}
.dp-term .term{padding:0;overflow:hidden;font-size:14px}
.dp-term .tb{display:flex;align-items:center;gap:7px;padding:12px 16px;border-bottom:1px solid #232B3A;color:#C9D1DC;font-size:13px}
.dp-term .tb i{width:10px;height:10px;border-radius:50%;background:#2C3546}.dp-term .tb span{margin-left:8px}
.dp-term .ln{padding:13px 18px;border-bottom:1px solid #161C28;animation:dp-in 6s ease both infinite}
@keyframes dp-in{0%{opacity:.25}12%,90%{opacity:1}100%{opacity:.25}}
.dp-term code{display:block;font-family:ui-monospace,'SFMono-Regular',Menlo,monospace;color:#E9EEF5;font-size:13.5px}
.dp-term .ln span{display:flex;align-items:center;gap:7px;color:#8BE6BE;font-size:13.5px;margin-top:5px}
.dp-ledger .led{margin-top:40px;overflow:hidden}
.dp-ledger .hd,.dp-ledger .r{display:grid;grid-template-columns:1fr 1.4fr 180px;gap:16px;padding:16px 22px;align-items:center}
.dp-ledger .hd{font-size:13px;color:var(--muted-2);background:#FAFBFC;border-bottom:1px solid var(--line)}
.dp-ledger .r{border-bottom:1px solid var(--line-2);font-size:16px;color:var(--muted)}.dp-ledger .r b{color:var(--ink)}
.dp-ledger .v{font-family:var(--display);font-size:24px;font-weight:600;color:#17694A;letter-spacing:-.02em;animation:dp-settle 5s ease infinite both}
@keyframes dp-settle{0%{color:#C9D1DC;filter:blur(3px)}15%,100%{color:#17694A;filter:none}}
.dp-keys .keys{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:40px;perspective:900px}
.dp-keys .key{background:linear-gradient(150deg,#141A26,#05070C);color:#fff;border-radius:20px;padding:28px;min-height:280px;display:flex;flex-direction:column;transform:rotateY(-8deg) rotateX(4deg);box-shadow:0 30px 60px rgba(10,14,22,.25);transition:transform .5s;position:relative;overflow:hidden}
.dp-keys .key:hover{transform:none}
.dp-keys .key::after{content:"";position:absolute;right:-60px;top:-60px;width:200px;height:200px;border-radius:50%;background:radial-gradient(closest-side,color-mix(in srgb,var(--c) 60%,transparent),transparent)}
.dp-keys .key i{font-size:30px;color:var(--c)}.dp-keys .key b{font-size:21px;margin-top:auto}.dp-keys .key p{font-size:15px;color:#C9D1DC;line-height:1.5;margin:8px 0 0}
.dp-size .stack{display:flex;flex-direction:column-reverse;gap:10px;align-items:center}
.dp-size .stack span{display:block;width:72%;height:44px;border-radius:10px;background:linear-gradient(90deg,#141A26,#1E2532);border:1px solid #2C3546;position:relative;animation:dp-grow 4s ease-in-out infinite;animation-delay:var(--d)}
.dp-size .stack span::after{content:"";position:absolute;right:16px;top:17px;width:10px;height:10px;border-radius:50%;background:#3DAE80;box-shadow:0 0 10px #3DAE80}
@keyframes dp-grow{0%,100%{width:60%}50%{width:84%}}
@media (max-width:900px){.dp-where .targets,.dp-keys .keys{grid-template-columns:1fr 1fr}.dp-ledger .hd,.dp-ledger .r{grid-template-columns:1fr 1fr 80px}.dp-where .cable{width:60px}}
</style>
