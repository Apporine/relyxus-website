---
// Section 4, light regulator outbox (locked). One outage starts several regulator
// clocks; each report is drafted from the live incident and sent only once signed.
---
<section class="r-ob" aria-labelledby="ob-title">
  <div class="mesh" aria-hidden="true"><i style="left:60px;top:80px;width:360px;height:300px;background:#9FB4D6"></i><i style="left:290px;top:190px;width:300px;height:260px;background:#3DAE80;opacity:.42"></i><i style="left:180px;top:20px;width:260px;height:200px;background:#E9EFF8"></i></div>
  <div class="wrap in">
    <h2 class="ttl" id="ob-title">The outage is one problem.<br /><span>The regulator's clock is the other.</span></h2>
    <p class="sub">One outage can start a clock with every regulator you answer to, each with its own deadline. Relyxus drafts every report from the live incident. Nothing is sent until you sign it.</p>
    <div class="how"><div><b>1</b>Outage detected</div><div><b>2</b>Relyxus drafts each report</div><div><b>3</b>You sign, Relyxus sends it</div></div>
    <div class="stage">
      <div class="win">
        <div class="wh"><div class="l"><i></i>Card payments down <small>since 09:41</small></div><div class="r">Incident clock <b class="ick">00:00:00</b></div></div>
        <div class="thd"><span>Regulator</span><span>What they need, and by when</span><span style="text-align:right">Status</span></div>
        <div class="rows"></div>
      </div>
      <div class="det" aria-live="polite"></div>
    </div>
    <div class="fn"><span>Deadlines from each regulator's published rules. FCA rules apply from 18 March 2027. Bank contract term, incident and times are an example.</span><a href="/tools/deadline-calculator"><u>See every deadline we track</u></a></div>
  </div>
</section>
<style is:global>
.r-ob{position:relative;overflow:hidden;background:#F4F6F9;color:#0B0D10;padding:104px 0 56px}
.r-ob .in{position:relative}
.r-ob .mesh{position:absolute;right:-140px;top:-180px;width:640px;height:560px;filter:blur(48px);opacity:.85;animation:r-drift 16s ease-in-out infinite alternate;pointer-events:none}
.r-ob .mesh i{position:absolute;border-radius:50%}
@keyframes r-drift{to{transform:translate(-60px,40px) rotate(8deg)}}
.r-ob .ttl{position:relative;font-family:var(--display);font-variation-settings:'opsz' 96;font-weight:600;font-size:clamp(34px,4.2vw,54px);line-height:1.04;letter-spacing:-.035em;margin:0;color:#0B0D10}
.r-ob .ttl span{color:#5C7397}
.r-ob .sub{position:relative;font-size:17px;line-height:1.55;color:#3E4652;margin:18px 0 0;max-width:620px}
.r-ob .how{position:relative;display:flex;gap:28px;flex-wrap:wrap;margin-top:26px;font-size:14px;color:#5E6672}
.r-ob .how div{display:flex;align-items:center;gap:9px;transition:color .4s}
.r-ob .how b{width:24px;height:24px;border-radius:50%;border:1px solid #C9D1DC;display:grid;place-items:center;font-size:11.5px;font-weight:600;color:#5E6672;background:#fff;transition:all .4s}
.r-ob .how div.on{color:#0B0D10}.r-ob .how div.on b{background:#0B0D10;border-color:#0B0D10;color:#fff}
.r-ob .how div.done b{background:#3DAE80;border-color:#3DAE80;color:#fff}
.r-ob .stage{position:relative;display:flex;gap:26px;align-items:center;margin-top:36px}
.r-ob .win{flex:1 1 0;min-width:0;background:#fff;border:1px solid #E1E6ED;border-radius:14px;box-shadow:0 30px 60px rgba(20,30,50,.12),0 2px 6px rgba(20,30,50,.05);overflow:hidden}
.r-ob .wh{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:15px 18px;border-bottom:1px solid #EDF0F4;font-size:13.5px}
.r-ob .wh .l{display:flex;align-items:center;gap:8px;font-weight:600}
.r-ob .wh .l i{width:8px;height:8px;border-radius:50%;background:#EF5A50;animation:r-ping 1.6s infinite}
@keyframes r-ping{0%{box-shadow:0 0 0 0 rgba(239,90,80,.45)}70%{box-shadow:0 0 0 7px rgba(239,90,80,0)}100%{box-shadow:0 0 0 0 rgba(239,90,80,0)}}
.r-ob .wh .l small{font-weight:400;color:#5E6672;font-size:12.5px}
.r-ob .wh .r{font-size:12.5px;color:#5E6672;font-variant-numeric:tabular-nums;white-space:nowrap}.r-ob .wh .r b{color:#0B0D10;font-weight:600}
.r-ob .thd,.r-ob .row{display:grid;grid-template-columns:minmax(110px,.9fr) 1.6fr 130px;gap:14px;align-items:center;padding:0 18px}
.r-ob .thd{font-size:12px;color:#5E6672;padding-top:10px;padding-bottom:10px;border-bottom:1px solid #EDF0F4;background:#FAFBFC}
.r-ob .row{padding-top:14px;padding-bottom:14px;border-bottom:1px solid #F1F3F6;font-size:13.5px;transition:background .4s;cursor:pointer}
.r-ob .row:last-child{border-bottom:0}.r-ob .row.f{background:#F3F6FB}
.r-ob .row .rn b{display:block;font-weight:600}.r-ob .row .rn small{color:#5E6672;font-size:12px}
.r-ob .row .nd{min-width:0}.r-ob .row .nd div{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.r-ob .row .nd small{overflow:hidden;text-overflow:ellipsis;display:block;color:#5E6672;font-size:12px;font-variant-numeric:tabular-nums;margin-top:2px;white-space:nowrap}
.r-ob .st{justify-self:end;text-align:right}
.r-ob .chip{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:999px;white-space:nowrap;transition:background .35s,color .35s}
.r-ob .chip.w{background:#F0F2F5;color:#5E6672}.r-ob .chip.d{background:#E8EEF7;color:#45608A}
.r-ob .chip.d i{width:10px;height:10px;border-radius:50%;border:1.5px solid #9FB4D6;border-top-color:#45608A;animation:r-spin .8s linear infinite}
@keyframes r-spin{to{transform:rotate(360deg)}}
.r-ob .chip.r{background:#0B0D10;color:#fff}.r-ob .chip.s{background:#DDF3E9;color:#1E7A55}
.r-ob .st small{display:block;font-size:11.5px;color:#5E6672;margin-top:4px;font-variant-numeric:tabular-nums;white-space:nowrap}.r-ob .st small.g{color:#1E7A55}
.r-ob .det{flex:0 0 260px;width:260px;align-self:center;background:#fff;border:1px solid #E1E6ED;border-radius:14px;box-shadow:0 34px 70px rgba(20,30,50,.18),0 2px 6px rgba(20,30,50,.06);padding:20px;transition:opacity .3s,transform .45s cubic-bezier(.2,.7,.1,1);min-height:300px}
.r-ob .det.sw{opacity:0;transform:translateY(10px)}
.r-ob .det .lab{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:#45608A}.r-ob .det .lab i{width:7px;height:7px;border-radius:50%;background:#9FB4D6}
.r-ob .det .lab.r{color:#0B0D10}.r-ob .det .lab.r i{background:#0B0D10}.r-ob .det .lab.s{color:#1E7A55}.r-ob .det .lab.s i{background:#3DAE80}
.r-ob .det .to{font-size:11.5px;color:#5E6672;margin-top:12px}.r-ob .det .to b{display:block;color:#0B0D10;font-size:13px;font-weight:600;margin-top:1px}
.r-ob .det .tt{font-size:16px;font-weight:600;letter-spacing:-.01em;margin-top:10px;line-height:1.25}
.r-ob .det .fs{margin-top:10px;border-top:1px solid #EDF0F4}
.r-ob .det .fr{display:flex;justify-content:space-between;gap:10px;padding:7px 0;border-bottom:1px solid #F3F5F8;font-size:12px}.r-ob .det .fr span{color:#5E6672}
.r-ob .det .fr em{font-style:normal;text-align:right}.r-ob .det .fr em.bar{display:block;width:70px;height:8px;border-radius:2px;background:#EDF0F4;margin-top:3px}
.r-ob .det .sig{height:34px;margin-top:8px;border-bottom:1px solid #0B0D10;position:relative}
.r-ob .det .sig svg{position:absolute;left:0;bottom:2px;width:110px;height:30px}
.r-ob .det .sig path{fill:none;stroke:#1B2A44;stroke-width:1.6;stroke-linecap:round;stroke-dasharray:140;stroke-dashoffset:140;transition:stroke-dashoffset .8s ease-out}
.r-ob .det .sig.on path{stroke-dashoffset:0}
.r-ob .det .sgl{font-size:11px;color:#5E6672;margin-top:4px}
.r-ob .det button.sgb{appearance:none;display:block;width:100%;margin-top:14px;border:0;border-radius:999px;padding:11px 0;font-size:13.5px;font-weight:600;cursor:pointer;background:#0B0D10;color:#fff;transition:background .35s,color .35s}
.r-ob .det button.sgb:disabled{background:#DDE3EB;color:#1F2630;cursor:default}
.r-ob .det button.sgb.ok{background:#3DAE80;color:#04130D}
.r-ob .fn{position:relative;margin-top:24px;font-size:12.5px;color:#5E6672;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
.r-ob .fn u{color:#0B0D10;text-underline-offset:3px;white-space:nowrap}
@media (max-width:860px){.r-ob .stage{flex-direction:column}.r-ob .det{width:100%;flex-basis:auto}.r-ob .thd,.r-ob .row{grid-template-columns:90px 1fr 110px}}
@media (max-width:520px){.r-ob .thd,.r-ob .row{grid-template-columns:1fr 104px}.r-ob .thd span:nth-child(2),.r-ob .row .nd{display:none}}
</style>
<script>
type R = { n: string; r: string; need: string; dueH: number; due: string; to: string; trig: number; draft: number; f: [string, string][] };
const R: R[] = [
  { n: "FCA", r: "United Kingdom", need: "Initial incident report", dueH: 24, due: "Due 09:41 tomorrow", to: "Financial Conduct Authority", trig: 0.5, draft: 0.42, f: [["Threshold met", "10:11"], ["Service affected", "Card payments"], ["Customers affected", "18,400"], ["Cause so far", "Card authorisation change"]] },
  { n: "US banks", r: "Fed, OCC, FDIC", need: "Incident notification", dueH: 36, due: "Due 22:23 tomorrow", to: "Primary federal regulator", trig: 0.7, draft: 0.4, f: [["Determined", "10:23"], ["Nature", "Operational, no attack"], ["Service affected", "Card payments"], ["Customers affected", "18,400"]] },
  { n: "MAS", r: "Singapore", need: "Incident notification", dueH: 1, due: "Due 10:47 today", to: "Monetary Authority of Singapore", trig: 0.1, draft: 0.38, f: [["Discovered", "09:47"], ["System", "Card authorisation"], ["Customers affected", "18,400"], ["Root cause report", "Within 14 days"]] },
  { n: "CBUAE", r: "United Arab Emirates", need: "Critical operation notice", dueH: 4, due: "Due 13:59 today", to: "Central Bank of the UAE", trig: 0.3, draft: 0.4, f: [["Impact from", "09:59"], ["Operation", "Card payments"], ["Restore estimate", "Under 1 hour"], ["Full report", "Within 24 hours"]] },
  { n: "Bank customers", r: "Your contracts", need: "Customer incident notice", dueH: 4, due: "Due 13:47 today", to: "12 bank customers", trig: 0.1, draft: 0.3, f: [["Impact from", "09:47"], ["Banks affected", "3 of 12"], ["Contract term", "Notify within 4 hours"], ["Status page", "Updated"]] },
];
const root = document.querySelector<HTMLElement>(".r-ob")!;
const p2 = (n: number) => String(n).padStart(2, "0");
const hms = (h: number) => { const s = Math.max(0, Math.round(h * 3600)); return `${p2(Math.floor(s / 3600))}:${p2(Math.floor((s % 3600) / 60))}:${p2(s % 60)}`; };
const hm = (h: number) => { h = Math.max(0, h); const H = Math.floor(h), M = Math.floor((h - H) * 60); return H ? `${H}h ${p2(M)}m` : `${M}m`; };
const at = (h: number) => { const m = Math.round(9 * 60 + 41 + h * 60) % 1440; return `${p2(Math.floor(m / 60))}:${p2(m % 60)}`; };
const rows = root.querySelector<HTMLElement>(".rows")!, det = root.querySelector<HTMLElement>(".det")!, ick = root.querySelector<HTMLElement>(".ick")!;
const how = [...root.querySelectorAll<HTMLElement>(".how > div")];
rows.innerHTML = R.map((r) => `<div class="row" tabindex="0" role="button"><div class="rn"><b>${r.n}</b><small>${r.r}</small></div><div class="nd"><div>${r.need}</div><small></small></div><div class="st"><span class="chip w">Waiting</span><small></small></div></div>`).join("");
const RW = [...rows.children] as HTMLElement[];
const SIG = "M4 22c6-9 10-15 13-14 3 1-6 15-3 15s9-13 12-12-3 10 0 10 6-8 9-8 1 6 4 6 5-5 8-5 2 4 5 4 4-3 7-3 1 2 3 2c4 0 10-3 14-4";
let T = 0, focus = -1, readyAt = 0, user = false, hold = 0; const sent: Record<number, number> = {};
RW.forEach((row, i) => { const pick = () => { user = true; hold = 0; if (focus !== i) { focus = i; card(i); } }; row.onclick = pick; row.onkeydown = (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); pick(); } }; });
function state(i: number) { const r = R[i]; if (T < r.trig) return "w"; if (sent[i] != null) return "s"; if (T < r.trig + r.draft) return "d"; return "r"; }
function card(i: number) {
  const r = R[i]; det.classList.add("sw");
  setTimeout(() => {
    det.innerHTML = `<div class="lab"><i></i><span></span></div><div class="to">To<b>${r.to}</b></div><div class="tt">${r.need}</div><div class="fs">${r.f.map((f) => `<div class="fr"><span>${f[0]}</span><em>${f[1]}</em></div>`).join("")}</div><div class="sig"><svg viewBox="0 0 120 30" aria-hidden="true"><path d="${SIG}"/></svg></div><div class="sgl">Head of Operational Resilience</div><button class="sgb">Sign and send</button>`;
    (det.querySelector(".sgb") as HTMLButtonElement).onclick = () => { user = true; sign(i); };
    det.dataset.i = String(i); det.classList.remove("sw"); paint();
  }, 220);
}
function sign(i: number) { if (state(i) !== "r") return; sent[i] = T; paint(); }
function paint() {
  if (focus < 0 || det.dataset.i !== String(focus)) return;
  const lab = det.querySelector<HTMLElement>(".lab"); if (!lab) return;
  const s = state(focus), r = R[focus], b = det.querySelector<HTMLButtonElement>(".sgb")!, sg = det.querySelector<HTMLElement>(".sig")!;
  lab.className = "lab" + (s === "r" ? " r" : s === "s" ? " s" : "");
  lab.querySelector("span")!.textContent = s === "d" ? "Relyxus is drafting" : s === "r" ? "Draft ready for your signature" : s === "s" ? `Sent ${hm(r.dueH - (sent[focus] - r.trig))} before the deadline` : "Waiting for its trigger";
  const fillN = s === "w" ? 0 : s === "d" ? Math.floor(((T - r.trig) / r.draft) * 4) : 4;
  det.querySelectorAll<HTMLElement>(".fr em").forEach((e, j) => { if (j < fillN) { if (e.classList.contains("bar")) { e.classList.remove("bar"); e.textContent = r.f[j][1]; } } else if (!e.classList.contains("bar")) { e.classList.add("bar"); e.textContent = ""; } });
  sg.classList.toggle("on", s === "s"); b.disabled = s !== "r"; b.classList.toggle("ok", s === "s");
  b.textContent = s === "s" ? `Sent at ${at(sent[focus])}` : s === "r" ? "Sign and send" : s === "d" ? "Drafting the report" : "Waiting for its trigger";
}
function frame(dt: number) {
  T += dt * 0.085; if (T > 1.62) { T = 0; for (const k in sent) delete sent[k]; focus = -1; user = false; hold = 0; }
  ick.textContent = hms(T);
  R.forEach((r, i) => {
    const s = state(i), row = RW[i], chip = row.querySelector<HTMLElement>(".chip")!, sm = row.querySelector<HTMLElement>(".st small")!, nd = row.querySelector<HTMLElement>(".nd small")!;
    nd.textContent = s === "w" ? "Clock starts when the trigger is met" : `${r.due}, ${hm(r.dueH - (T - r.trig))} left`;
    if (s === "s") nd.textContent = r.due;
    const lab = ({ w: "Waiting", d: "Drafting", r: "Ready to sign", s: "Sent" } as Record<string, string>)[s];
    if (chip.dataset.s !== s) { chip.dataset.s = s; chip.className = "chip " + s; chip.innerHTML = (s === "d" ? "<i></i>" : "") + lab; }
    sm.className = s === "s" ? "g" : ""; sm.textContent = s === "s" ? `${at(sent[i])}, ${hm(r.dueH - (sent[i] - r.trig))} early` : s === "w" ? "" : s === "r" ? "Needs your signature" : "From the live incident";
    row.classList.toggle("f", i === focus);
  });
  const ready = R.map((_, i) => i).filter((i) => state(i) === "r"), drafting = R.map((_, i) => i).filter((i) => state(i) === "d");
  hold -= dt;
  if (hold <= 0 && !user) {
    let nf = focus;
    if (focus < 0 || state(focus) === "s" || state(focus) === "w") nf = ready.length ? ready.reduce((a, b) => (R[a].dueH <= R[b].dueH ? a : b)) : drafting.length ? drafting.reduce((a, b) => (R[a].dueH <= R[b].dueH ? a : b)) : focus;
    if (nf !== focus && nf >= 0) { focus = nf; card(nf); readyAt = 0; }
  }
  if (focus >= 0 && state(focus) === "r" && !user) { readyAt += dt; if (readyAt > 1.6) { sign(focus); hold = 2.2; readyAt = 0; } }
  paint();
  const any = R.some((_, i) => state(i) !== "w"), allS = R.every((_, i) => state(i) === "s"), anyR = ready.length > 0 || (focus >= 0 && state(focus) === "s");
  how[0].className = any ? "done" : "on"; how[1].className = !any ? "" : drafting.length ? "on" : "done"; how[2].className = allS ? "done" : anyR ? "on" : "";
}
let last = 0, vis = false; new IntersectionObserver((e) => (vis = e[0].isIntersecting), { threshold: 0.15 }).observe(root);
function loop(ts: number) { const t = ts / 1000, dt = Math.min(0.05, t - last || 0.016); last = t; if (vis) frame(dt); requestAnimationFrame(loop); }
if (matchMedia("(prefers-reduced-motion: reduce)").matches) { T = 0.9; frame(0); frame(0); } else requestAnimationFrame(loop);
</script>
