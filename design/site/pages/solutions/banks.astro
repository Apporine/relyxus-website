---
import Page from "../../layouts/Page.astro";
const qs = [["When did you first know?", "The detection time, from the first alert, to the second"], ["Who decided what, and when?", "Every decision and approval, with names and passkeys"], ["How many customers were affected?", "Customer impact, measured during the incident"], ["Did you stay within your impact tolerance?", "Tolerance tracked live for each important business service"], ["When did you tell us?", "Every report, its deadline and when it was sent"]];
const svc = [["Card payments", 70], ["Faster Payments", 42], ["Mobile app", 58], ["Online banking", 35]];
---
<Page title="Relyxus for banks and building societies" description="Built for the night your bank goes down: one owner, the cause with evidence, a fix two people approve, and the regulator report drafted as it happens." path="/solutions/banks" tone="dark" current="/solutions/banks">
  <section class="k-sec k-dark bk-hero">
    <div class="sky" aria-hidden="true">{Array.from({ length: 9 }).map((_, b) => <div class="bld" style={`--h:${90 + ((b * 37) % 110)}px;--d:${(b % 4) * 0.7}s`}>{Array.from({ length: 18 }).map(() => <i></i>)}</div>)}</div>
    <div class="wrap in"><span class="k-tag"><i class="d"></i>Banks and building societies</span><h1 class="k-h1" style="margin-top:16px;max-width:900px">Built for the night <span>your bank goes down.</span></h1><p class="k-lede">The windows go dark one floor at a time. Relyxus brings them back in order: the right person, the cause, an approved fix, and the report your regulator expects.</p><div class="k-btns"><a class="k-b3" href="/demo#book">Book a demo</a><a class="k-b2" href="/replay">Replay one of your outages</a></div></div>
  </section>
  <section class="k-sec k-white bk-q">
    <div class="wrap k-split">
      <div><h2 class="k-h2">The questions your regulator asks the next morning. <span>Answered before they ask.</span></h2></div>
      <ul class="list">{qs.map(([q, a], i) => <li style={`animation-delay:${i * 0.6}s`}><span class="tk"><i class="ti ti-check"></i></span><div><b>{q}</b><small>{a}</small></div></li>)}</ul>
    </div>
  </section>
  <section class="k-sec k-mist bk-svc">
    <div class="wrap"><h2 class="k-h2">Card payments, Faster Payments, <span>mobile, online banking.</span></h2>
      <div class="tiles">{svc.map(([n, v]) => <div class="tile k-card"><b>{n}</b><div class="band"><span class="lim"></span><i style={`--v:${v}%`}></i></div><small>Within impact tolerance</small></div>)}</div>
      <p class="k-note">Example services and values. You set the tolerance for each important business service.</p>
    </div>
  </section>
  <section class="k-sec k-navy bk-cloud"><div class="wrap k-split"><div><h2 class="k-h2">Installed inside your bank, <span>not ours.</span></h2><p class="k-lede">Relyxus runs in your own cloud account or fully air gapped, with your keys and your audit log. There is no Relyxus copy of your data.</p><div class="k-btns"><a class="k-b3" href="/deployment">See how it is deployed</a></div></div><div class="box"><span>Your bank</span><div class="inner"><b>Relyxus</b><small>Your keys, your region</small></div></div></div></section>
  <section class="k-sec k-dark bk-seats"><div class="wrap k-split"><div><h2 class="k-h2">Five banks will shape <span>what Relyxus becomes.</span></h2><p class="k-lede">Founder pricing for the first five partners, in return for a named case study and reference calls.</p><div class="k-btns"><a class="k-b3" href="/pricing#founding-partners">Apply for a place</a></div></div><div class="chairs">{[1, 2, 3, 4, 5].map((n) => <div class="ch"><em>{n}</em><span>Open</span></div>)}</div></div></section>
</Page>
<style is:global>
.bk-hero{padding:110px 0 260px;background:linear-gradient(#05070C,#0A0F1E)}
.bk-hero .in{position:relative;z-index:2}
.bk-hero .sky{position:absolute;left:0;right:0;bottom:0;display:flex;align-items:flex-end;gap:10px;justify-content:center;opacity:.95}
.bk-hero .bld{width:9%;height:var(--h);background:#0D121C;border:1px solid #1C2330;border-bottom:0;display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:14px 12px;align-content:start}
.bk-hero .bld i{height:10px;border-radius:2px;background:#F2C27B;opacity:.9;animation:bk-win 6s ease-in-out infinite;animation-delay:var(--d)}
.bk-hero .bld i:nth-child(3n){animation-delay:calc(var(--d) + .4s)}.bk-hero .bld i:nth-child(4n){background:#9FB4D6}
@keyframes bk-win{0%,20%{opacity:.9}35%,55%{opacity:.08}75%,100%{opacity:.9}}
.bk-q .list{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px}
.bk-q li{display:grid;grid-template-columns:40px 1fr;gap:14px;padding:16px 18px;border:1px solid var(--line);border-radius:14px}
.bk-q .tk{width:32px;height:32px;border-radius:50%;background:#3DAE80;color:#fff;display:grid;place-items:center}
.bk-q li b{font-size:18px}.bk-q li small{display:block;font-size:15px;color:var(--muted);margin-top:4px}
.bk-svc .tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:40px}
.bk-svc .tile{padding:22px}.bk-svc .tile b{font-size:18px}.bk-svc .tile small{color:#17694A;font-weight:600;font-size:13.5px}
.bk-svc .band{position:relative;height:90px;margin:18px 0 10px;border-radius:10px;background:linear-gradient(#FDEDEA 0 25%,#F4FBF8 25%)}
.bk-svc .lim{position:absolute;left:0;right:0;top:25%;border-top:2px dashed #E5482A}
.bk-svc .band i{position:absolute;left:8px;right:8px;bottom:8px;height:var(--v);max-height:70%;border-radius:6px;background:linear-gradient(#7FD8B0,#3DAE80);animation:bk-rise 3.5s ease-in-out infinite alternate}
@keyframes bk-rise{from{height:20%}to{height:var(--v)}}
.bk-cloud .box{border:1px dashed #3A4458;border-radius:24px;padding:24px;min-height:300px;display:flex;flex-direction:column}
.bk-cloud .box>span{color:#C9D1DC;font-size:14px}.bk-cloud .inner{margin:auto;width:70%;border-radius:18px;background:linear-gradient(150deg,#1A2333,#0B0F18);border:1px solid #3A4458;padding:30px;text-align:center;box-shadow:0 0 60px rgba(61,174,128,.25)}
.bk-cloud .inner b{display:block;font-family:var(--display);font-size:30px}.bk-cloud .inner small{color:#C9D1DC}
.bk-seats .chairs{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
.bk-seats .ch{height:150px;border:1px dashed #3A4458;border-radius:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px}
.bk-seats .ch em{font-style:normal;font-family:var(--display);font-size:36px}.bk-seats .ch span{color:#8BE6BE;font-weight:600;font-size:14px}
@media (max-width:900px){.bk-svc .tiles{grid-template-columns:1fr 1fr}.bk-hero .bld{width:11%}}
</style>
