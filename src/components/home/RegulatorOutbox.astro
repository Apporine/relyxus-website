---
// Section 4, deadline cards (locked; homepage tweak 7, 15 Nov 2026).
// Dark graphite. One outage starts four regulator clocks, each a card with its
// deadline, what is owed, when its clock started and a Draft, Sign, Send line.
// Click a card to flip it and see the report. Incident and times are an example.
---
<section class="r-ob" aria-labelledby="ob-title">
  <div class="wrap in">
    <div class="guides" aria-hidden="true"></div>
    <div class="top">
      <div>
        <h2 class="ttl" id="ob-title">The outage is one problem. <span>The regulator's clock is the other.</span></h2>
        <p class="lead">One outage starts a clock with every regulator you answer to. Relyxus drafts each report from the live incident, your team signs it, and it goes out long before the deadline.</p>
      </div>
      <div class="fine"><b>£48.65m</b><span>fined to one UK bank in 2022 after a failed IT migration locked customers out.</span></div>
    </div>
    <div class="inc"><i aria-hidden="true"></i><span><b>09:41</b> Card payments fail for 18,400 customers</span><span class="sp"></span><span class="k">Incident clock <b class="ick">00:00:00</b></span><span class="k"><b class="ckn">0</b> of 4 clocks running</span></div>
    <div class="cards"></div>
    <div class="fn"><span>Deadlines from each regulator's published rules. FCA rules apply from 18 March 2027. Fine: FCA and PRA, December 2022. Incident and times are an example. Click a card to see its report.</span><a href="/deadline-calculator"><u>See every deadline we track</u></a></div>
  </div>
</section>

<style is:global>
.r-ob{position:relative;overflow:hidden;background:#0B0D11;color:#fff;font-family:var(--body);padding:104px 0 88px}
.r-ob:before{content:'';position:absolute;left:50%;top:-220px;width:1100px;height:560px;margin-left:-550px;background:radial-gradient(closest-side,rgba(159,180,214,.16),transparent);pointer-events:none}
.r-ob .in{position:relative}
.r-ob .guides{position:absolute;inset:-104px 0 -88px;pointer-events:none;background:linear-gradient(90deg,transparent 11px,rgba(255,255,255,.06) 11px,rgba(255,255,255,.06) 12px,transparent 12px,transparent calc(100% - 12px),rgba(255,255,255,.06) calc(100% - 12px),rgba(255,255,255,.06) calc(100% - 11px),transparent calc(100% - 11px))}
.r-ob .top{position:relative;display:grid;grid-template-columns:1.6fr 1fr;gap:48px;align-items:end}
.r-ob .ttl{font-family:var(--display);font-variation-settings:'opsz' 96;font-weight:500;font-size:clamp(30px,3.2vw,40px);line-height:1.1;letter-spacing:-.035em;margin:0;color:#fff}
.r-ob .ttl span{color:#9AA3B2}
.r-ob .lead{font-size:16px;line-height:1.6;color:#C9CED6;margin:16px 0 0;max-width:580px}
.r-ob .fine{border-left:2px solid #FF6B4A;padding-left:18px}
.r-ob .fine b{display:block;font-weight:300;font-size:48px;letter-spacing:-.045em;line-height:1;color:#fff}
.r-ob .fine span{display:block;font-size:13.5px;color:#C9CED6;margin-top:10px;line-height:1.5}
.r-ob .inc{position:relative;margin-top:40px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:14px 18px;border:1px solid rgba(255,255,255,.12);border-radius:12px;background:rgba(255,255,255,.03);font-size:14px;color:#E9EEF5}
.r-ob .inc i{width:8px;height:8px;border-radius:50%;background:#EF5A50;animation:rob-ping 1.6s infinite}
@keyframes rob-ping{0%{box-shadow:0 0 0 0 rgba(239,90,80,.5)}70%{box-shadow:0 0 0 8px rgba(239,90,80,0)}100%{box-shadow:0 0 0 0 rgba(239,90,80,0)}}
.r-ob .inc b{font-weight:600;color:#fff}
.r-ob .inc .sp{flex:1}
.r-ob .inc .k{font-size:13px;color:#C9CED6;font-variant-numeric:tabular-nums}.r-ob .inc .k b{font-weight:600;color:#fff}
.r-ob .cards{position:relative;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px;perspective:1000px}
.r-ob .cw{position:relative;height:350px;cursor:pointer}
.r-ob .cw:focus-visible{outline:2px solid #9FB4D6;outline-offset:4px;border-radius:18px}
.r-ob .cd{position:absolute;inset:0;transition:transform .3s ease-out}
.r-ob .fc{position:absolute;inset:0;border-radius:16px;overflow:hidden;padding:18px;display:flex;flex-direction:column;box-shadow:0 26px 60px rgba(0,0,0,.45);transition:opacity .45s,transform .55s cubic-bezier(.3,.7,.2,1)}
.r-ob .fc.bk{background:#fff;color:#0A0C10;padding:18px 18px 16px;opacity:0;transform:scale(.94) rotate(-2deg);pointer-events:none}
.r-ob .cw.flip .fc:not(.bk){opacity:0;transform:scale(.94) rotate(2deg)}
.r-ob .cw.flip .fc.bk{opacity:1;transform:none}
.r-ob .fc .bg{position:absolute;inset:0;background-size:300% 300%;animation:rob-sheen 10s ease-in-out infinite alternate}
@keyframes rob-sheen{from{background-position:0% 30%}to{background-position:100% 70%}}
.r-ob .fc .gl{position:absolute;inset:0;background:linear-gradient(115deg,transparent 35%,rgba(255,255,255,.5) 48%,transparent 60%);background-size:250% 100%;animation:rob-gl 7s ease-in-out infinite}
@keyframes rob-gl{0%{background-position:120% 0}60%,100%{background-position:-60% 0}}
.r-ob .fc>*{position:relative}
.r-ob .fc.k{color:#fff;border:1px solid rgba(255,255,255,.14)}
.r-ob .fc.k canvas{position:absolute;inset:0;width:100%;height:100%}
.r-ob .fc.k:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,16,20,.9) 0,rgba(14,16,20,.2) 32%,rgba(14,16,20,.2) 42%,rgba(14,16,20,.94) 70%);pointer-events:none}
.r-ob .fc.k>*:not(canvas){z-index:2}
.r-ob .hd{display:flex;justify-content:space-between;align-items:flex-start;font-size:14px;font-weight:600;color:#0A0C10}
.r-ob .hd small{display:block;font-weight:500;font-size:12px;margin-top:2px;color:#1F2630}
.r-ob .fc.k .hd,.r-ob .fc.k .hd small{color:#fff}
.r-ob .chipx{width:32px;height:24px;border-radius:5px;background:linear-gradient(135deg,rgba(255,255,255,.95),rgba(255,255,255,.45));border:1px solid rgba(255,255,255,.75)}
.r-ob .big{margin-top:auto;font-weight:300;font-size:64px;letter-spacing:-.05em;line-height:.9;color:#0A0C10}
.r-ob .fc.k .big{color:#fff}
.r-ob .owe{font-size:13.5px;font-weight:600;margin-top:8px;color:#0A0C10}.r-ob .owe small{display:block;font-weight:500;font-size:12px;color:#1F2630;margin-top:2px}
.r-ob .fc.k .owe{color:#fff}.r-ob .fc.k .owe small{color:#E9EEF5}
.r-ob .strip{margin-top:12px;border-radius:11px;background:rgba(255,255,255,.8);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);color:#0A0C10;padding:10px 11px}
.r-ob .fc.k .strip{background:rgba(255,255,255,.12);color:#fff}
.r-ob .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:4px}
.r-ob .steps i{height:3px;border-radius:2px;background:rgba(10,12,16,.15);overflow:hidden;position:relative}
.r-ob .fc.k .steps i{background:rgba(255,255,255,.2)}
.r-ob .steps i b{position:absolute;inset:0;background:#0A0C10;transform:scaleX(0);transform-origin:left;transition:transform .5s}
.r-ob .fc.k .steps i b{background:#fff}
.r-ob .steps i.g b{background:#2E9C70}
.r-ob .sl2{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;font-size:11px;font-weight:500;margin-top:5px;color:#3E4652}
.r-ob .fc.k .sl2{color:#C9CED6}
.r-ob .sl2 span.on{color:#0A0C10;font-weight:600}.r-ob .fc.k .sl2 span.on{color:#fff}
.r-ob .stt{display:flex;justify-content:space-between;align-items:center;margin-top:7px;font-size:12px;font-weight:600;font-variant-numeric:tabular-nums}
.r-ob .stt em{font-style:normal;font-weight:500;color:#3E4652}.r-ob .fc.k .stt em{color:#E9EEF5}
.r-ob .stt .g{color:#17694A}.r-ob .fc.k .stt .g{color:#8BE6BE}
.r-ob .vw{font-size:12px;font-weight:600;margin-top:10px;text-decoration:underline;text-underline-offset:3px;color:#0A0C10}
.r-ob .fc.k .vw{color:#fff}
.r-ob .bk .pt{display:flex;justify-content:space-between;font-size:10px;color:#5B6472;border-bottom:1px solid #0A0C10;padding-bottom:6px}
.r-ob .bk .to{font-size:10px;color:#5B6472;margin-top:10px}.r-ob .bk .to b{display:block;color:#0A0C10;font-size:12px;font-weight:600;margin-top:1px}
.r-ob .bk .tt{font-size:15px;font-weight:600;margin-top:8px;letter-spacing:-.01em}
.r-ob .bk .fs{margin-top:8px}
.r-ob .bk .fs div{display:flex;justify-content:space-between;gap:8px;font-size:11.5px;padding:5px 0;border-bottom:1px solid #F1F3F6}
.r-ob .bk .fs span{color:#5B6472}
.r-ob .bk .fs b{font-weight:500;text-align:right}
.r-ob .bk .sg{margin-top:auto;border-top:1px solid #0A0C10;padding-top:3px;font-size:9.5px;color:#5B6472;position:relative}
.r-ob .bk svg{position:absolute;left:0;bottom:14px;width:100px;height:26px;transition:opacity .3s}
.r-ob .bk path{fill:none;stroke:#1B2A44;stroke-width:1.6;stroke-linecap:round}
.r-ob .bk .stp{position:absolute;right:0;bottom:22px;border:2px solid #2E9C70;color:#2E9C70;border-radius:4px;padding:2px 7px;font-size:10px;font-weight:700;letter-spacing:.08em;transform:rotate(-8deg);text-align:center;line-height:1.2}
.r-ob .bk .stp small{display:block;font-size:8.5px;font-weight:500;letter-spacing:0}
.r-ob .bk .stp.no{border-color:#9AA3B2;color:#5B6472}
.r-ob .bk .bkl{font-size:12px;font-weight:600;margin-top:10px;text-decoration:underline;text-underline-offset:3px}
.r-ob .fn{position:relative;margin-top:26px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:14px;color:#C9D1DC}
.r-ob .fn span{max-width:820px;line-height:1.5}
.r-ob .fn u{color:#fff;text-underline-offset:3px}
@media (max-width:1100px){.r-ob .cards{grid-template-columns:1fr 1fr}.r-ob .cw{height:360px}}
@media (max-width:760px){.r-ob .inc{display:grid;grid-template-columns:auto 1fr;row-gap:6px;column-gap:10px}.r-ob .inc .sp{display:none}.r-ob .inc .k{grid-column:2}.r-ob{padding:72px 0 64px}.r-ob .top{grid-template-columns:1fr;gap:28px}.r-ob .guides{display:none}}
@media (max-width:520px){.r-ob .cards{grid-template-columns:1fr}.r-ob .cw{height:340px}}
</style>

<script>
type Reg = { n: string; c: string; big: string; owe: string; trig: string; dh: number; t0: number; dr: number; to: string; f: [string, string][]; g: string };
const root = document.querySelector<HTMLElement>(".r-ob");
if (root) {
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const R: Reg[] = [
    { n: "MAS", c: "Singapore", big: "1h", owe: "Incident notification", trig: "Discovered", dh: 1, t0: 0.1, dr: 0.38, to: "Monetary Authority of Singapore", f: [["Discovered", "09:47"], ["System", "Card authorisation"], ["Customers", "18,400"]], g: "linear-gradient(135deg,#FFD9C4,#FF8A66,#FF6B4A,#FFC2A3)" },
    { n: "CBUAE", c: "United Arab Emirates", big: "4h", owe: "Critical operation notice", trig: "Critical operation hit", dh: 4, t0: 0.3, dr: 0.4, to: "Central Bank of the UAE", f: [["Impact from", "09:59"], ["Operation", "Card payments"], ["Restore estimate", "Under 1 hour"]], g: "dark" },
    { n: "FCA", c: "United Kingdom", big: "24h", owe: "Initial incident report", trig: "Threshold met", dh: 24, t0: 0.5, dr: 0.42, to: "Financial Conduct Authority", f: [["Threshold met", "10:11"], ["Customers harmed", "18,400"], ["Cause so far", "Card authorisation change"]], g: "linear-gradient(135deg,#F4F6F9,#D5DEEC,#9FB4D6,#E9EEF5)" },
    { n: "US banks", c: "Fed, OCC, FDIC", big: "36h", owe: "Incident notification", trig: "Judged notifiable", dh: 36, t0: 0.7, dr: 0.4, to: "Primary federal regulator", f: [["Determined", "10:23"], ["Nature", "Operational, no attack"], ["Customers", "18,400"]], g: "linear-gradient(135deg,#EAF7F0,#BDEBD6,#7FD0AE,#E9EEF5)" },
  ];
  const p2 = (n: number) => String(n).padStart(2, "0");
  const hm = (h: number) => { h = Math.max(0, h); const H = Math.floor(h), M = Math.floor((h - H) * 60); return H ? `${H}h ${p2(M)}m` : `${M}m`; };
  const at = (h: number) => { const m = Math.round(9 * 60 + 41 + h * 60) % 1440; return `${p2(Math.floor(m / 60))}:${p2(m % 60)}`; };
  const hms = (h: number) => { const s = Math.round(h * 3600); return `${p2(Math.floor(s / 3600))}:${p2(Math.floor((s % 3600) / 60))}:${p2(s % 60)}`; };
  const sentAt = (r: Reg) => r.t0 + r.dr + 0.12;
  const early = (r: Reg) => hm(r.dh - (sentAt(r) - r.t0));
  const st = (r: Reg, T: number) => (T < r.t0 ? "w" : T < r.t0 + r.dr ? "d" : T < sentAt(r) ? "r" : "s");
  const sig = '<svg viewBox="0 0 120 30" aria-hidden="true"><path d="M4 22c6-9 10-15 13-14 3 1-6 15-3 15s9-13 12-12-3 10 0 10 6-8 9-8 1 6 4 6 5-5 8-5 2 4 5 4 4-3 7-3 1 2 3 2c4 0 10-3 14-4"/></svg>';

  const cards = root.querySelector<HTMLElement>(".cards")!;
  cards.innerHTML = R.map((r) => `<div class="cw" tabindex="0" role="button" aria-pressed="false" aria-label="${r.n}, ${r.big} deadline. Press to see the report"><div class="cd">
<div class="fc ${r.g === "dark" ? "k" : ""}">${r.g === "dark" ? "<canvas aria-hidden=\"true\"></canvas>" : `<div class="bg" style="background-image:${r.g}"></div><div class="gl"></div>`}
<div class="hd"><span>${r.n}<small>${r.c}</small></span><span class="chipx" aria-hidden="true"></span></div>
<div class="big">${r.big}</div><div class="owe">${r.owe}<small class="cs">Clock starts when: ${r.trig.toLowerCase()}</small></div>
<div class="strip"><div class="steps"><i><b></b></i><i><b></b></i><i><b></b></i></div><div class="sl2"><span>Draft</span><span>Sign</span><span>Send</span></div><div class="stt"><span class="lb">Waiting</span><em></em></div></div>
<div class="vw">See the report</div></div>
<div class="fc bk"><div class="pt"><span>Example bank</span><span>INC 2047</span></div><div class="to">To<b>${r.to}</b></div><div class="tt">${r.owe}</div><div class="fs">${r.f.map((f) => `<div><span>${f[0]}</span><b>${f[1]}</b></div>`).join("")}</div><div class="sg">${sig}Head of Operational Resilience<div class="stp">SENT<small>${early(r)} early</small></div></div><div class="bkl">Back to the clock</div></div>
</div></div>`).join("");

  const CW = [...cards.children] as HTMLElement[];
  const hoverable = matchMedia("(hover: hover) and (pointer: fine)").matches;
  CW.forEach((c) => {
    const cd = c.querySelector<HTMLElement>(".cd")!;
    const t = () => { const on = c.classList.toggle("flip"); c.setAttribute("aria-pressed", String(on)); if (on) cd.style.transform = ""; };
    c.addEventListener("click", t);
    c.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); t(); } });
    if (hoverable && !reduce) {
      c.addEventListener("mousemove", (e) => {
        if (c.classList.contains("flip")) return;
        const b = c.getBoundingClientRect(), x = (e.clientX - b.left) / b.width - 0.5, y = (e.clientY - b.top) / b.height - 0.5;
        cd.style.transform = `rotateY(${(x * 10).toFixed(2)}deg) rotateX(${(-y * 8).toFixed(2)}deg)`;
      });
      c.addEventListener("mouseleave", () => { cd.style.transform = ""; });
    }
  });

  // Dotted canvas for the dark CBUAE card.
  const dk = CW[1].querySelector("canvas") as HTMLCanvasElement, dx = dk.getContext("2d")!;
  const DOT: number[] = []; let sd = 5;
  const rr = () => (sd = (sd * 16807) % 2147483647) / 2147483647;
  for (let i = 0; i < 600; i++) DOT.push(rr());
  function dots(t: number) {
    const D = Math.min(2, devicePixelRatio || 1), w = dk.clientWidth, h = dk.clientHeight;
    if (!w) return;
    if (dk.width !== Math.round(w * D)) { dk.width = Math.round(w * D); dk.height = Math.round(h * D); }
    dx.setTransform(D, 0, 0, D, 0, 0); dx.fillStyle = "#0E1014"; dx.fillRect(0, 0, w, h);
    let n = 0;
    for (let y = 6; y < h; y += 11) for (let x = 6; x < w; x += 11) {
      const k = DOT[n++ % 600], v = Math.sin(t * 0.6 + k * 30);
      dx.fillStyle = v < 0.2 ? "#181B21" : k < 0.07 ? "#FF6B4A" : k < 0.18 ? "#9FB4D6" : k < 0.24 ? "#3DAE80" : v > 0.85 ? "#E9EEF5" : "#30353D";
      dx.beginPath(); dx.arc(x, y, 2, 0, 6.283); dx.fill();
    }
  }

  const ick = root.querySelector<HTMLElement>(".ick")!, ckn = root.querySelector<HTMLElement>(".ckn")!;
  let T = 0;
  function frame(dt: number, t: number) {
    T += dt * 0.075; if (T > 1.8) T = 0;
    ick.textContent = hms(T);
    let running = 0;
    R.forEach((r, i) => {
      const s = st(r, T), c = CW[i];
      const steps = c.querySelectorAll<HTMLElement>(".steps i"), sl = c.querySelectorAll<HTMLElement>(".sl2 span");
      const lb = c.querySelector<HTMLElement>(".lb")!, em = c.querySelector<HTMLElement>(".stt em")!, cs = c.querySelector<HTMLElement>(".cs")!;
      if (s !== "w") running++;
      const pd = s === "w" ? 0 : s === "d" ? (T - r.t0) / r.dr : 1, ps = s === "r" ? (T - r.t0 - r.dr) / 0.12 : s === "s" ? 1 : 0, pn = s === "s" ? 1 : 0;
      [pd, ps, pn].forEach((p, k) => { steps[k].querySelector<HTMLElement>("b")!.style.transform = `scaleX(${p})`; steps[k].classList.toggle("g", s === "s"); });
      sl.forEach((x, k) => x.classList.toggle("on", (s === "d" && k === 0) || (s === "r" && k === 1) || (s === "s" && k === 2)));
      cs.textContent = s === "w" ? `Clock starts when: ${r.trig.toLowerCase()}` : `Clock started ${at(r.t0)}, ${r.trig.toLowerCase()}`;
      lb.className = "lb" + (s === "s" ? " g" : "");
      lb.textContent = s === "w" ? "Waiting" : s === "d" ? "Drafting" : s === "r" ? "Ready to sign" : "Sent " + at(sentAt(r));
      em.textContent = s === "w" ? "" : s === "s" ? `${early(r)} early` : `${hm(r.dh - (T - r.t0))} left`;
      const sp = c.querySelector<HTMLElement>(".bk .stp")!, want = s === "s" ? "s" : s === "w" ? "w" : "d";
      if (sp.dataset.s !== want) {
        sp.dataset.s = want; sp.className = "stp" + (want === "s" ? "" : " no");
        sp.innerHTML = want === "s" ? `SENT<small>${early(r)} early</small>` : want === "w" ? "NOT STARTED" : "DRAFT<small>awaiting signature</small>";
      }
      c.querySelector<SVGElement>(".bk svg")!.style.opacity = s === "s" ? "1" : "0";
    });
    ckn.textContent = String(running);
    dots(t);
  }

  if (reduce) { T = 1.4; frame(0, 0); }
  else {
    let last = 0, raf = 0, visible = false;
    const loop = (ts: number) => { const t = ts / 1000, dt = Math.min(0.05, t - last || 0.016); last = t; frame(dt, t); raf = requestAnimationFrame(loop); };
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !visible) { visible = true; last = performance.now() / 1000; raf = requestAnimationFrame(loop); }
      else if (!e.isIntersecting && visible) { visible = false; cancelAnimationFrame(raf); }
    }, { rootMargin: "100px" }).observe(root);
  }
}
</script>
