---
// Vigil, the website assistant (15 Nov 2026). A Halo launcher at the bottom
// right opens a panel where visitors type or talk. Vigil answers from the
// published facts, shows real product screens beside the chat, asks a few
// qualifying questions, takes name, work email and company for a demo, a
// replay, a quote or a person, and books a meeting. Setup: agent/README.md.
---
<div class="va" data-vg>
  <button class="va-launch" type="button" aria-haspopup="dialog" aria-controls="va-panel" data-va-open>
    <canvas class="va-mini" width="44" height="44" aria-hidden="true"></canvas>
    <span>Ask Vigil</span>
  </button>

  <div class="va-shell" hidden data-va-shell>
    <aside class="va-stage" hidden data-va-stage aria-label="Shared by Vigil">
      <div class="va-sh"><span>Shared by Vigil</span><button type="button" class="va-ic" aria-label="Close shared screen" data-va-unstage><i class="ti ti-x"></i></button></div>
      <figure class="va-fig"><img alt="" data-va-img /><figcaption data-va-cap></figcaption></figure>
      <a class="va-open" href="/" data-va-href>Open this page <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a>
    </aside>

    <section class="va-panel" id="va-panel" role="dialog" aria-modal="false" aria-label="Chat with Vigil">
      <header class="va-top">
        <div class="va-bar">
          <a class="va-book" href="/demo#book" target="_blank" rel="noopener" data-va-book><i class="ti ti-calendar" aria-hidden="true"></i>Book a meeting</a>
          <div class="va-ctl">
            <button type="button" class="va-ic" aria-pressed="false" aria-label="Read answers aloud" title="Read answers aloud" data-va-speaker><i class="ti ti-volume-off"></i></button>
            <button type="button" class="va-ic" aria-label="Close chat" title="Close" data-va-close><i class="ti ti-x"></i></button>
          </div>
        </div>
        <canvas class="va-halo" aria-hidden="true" data-va-halo></canvas>
        <p class="va-state" aria-live="polite" data-va-state>Vigil, the Relyxus assistant</p>
        <div class="va-call" data-va-call>
          <button type="button" class="va-talk" data-va-talk><i class="ti ti-phone" aria-hidden="true"></i>Talk live with Vigil</button>
          <div class="va-live" hidden data-va-live>
            <button type="button" class="va-ic va-mute" aria-pressed="false" aria-label="Mute your microphone" title="Mute" data-va-mute><i class="ti ti-microphone"></i></button>
            <span class="va-timer" data-va-timer>0:00</span>
            <button type="button" class="va-end" data-va-end><i class="ti ti-phone-off" aria-hidden="true"></i>End call</button>
          </div>
        </div>
      </header>

      <div class="va-log" role="log" aria-live="polite" data-va-log></div>
      <div class="va-chips" data-va-chips></div>

      <form class="va-in" data-va-form>
        <label class="sr-only" for="va-text">Message Vigil</label>
        <textarea id="va-text" rows="1" placeholder="Ask about Relyxus" maxlength="600" data-va-text></textarea>
        <button type="button" class="va-mic" aria-label="Talk live with Vigil" title="Talk live with Vigil" data-va-mic><i class="ti ti-microphone"></i></button>
        <button type="submit" class="va-send" aria-label="Send"><i class="ti ti-arrow-up"></i></button>
      </form>
      <p class="va-legal">Vigil is an AI assistant and can make mistakes. Voice calls are processed by Google to run Vigil. If you share your name and email, we keep them with this chat so the team can reply. <a href="/privacy">Privacy notice</a></p>
    </section>
  </div>
</div>

<style is:global>
.va{--va-bg:#06080C;--va-line:#1E2635;--va-tx:#E9EEF5;--va-sub:#C9D3E3;font-family:var(--body)}
.va-launch{position:fixed;right:24px;bottom:24px;z-index:80;display:flex;align-items:center;gap:10px;padding:6px 18px 6px 6px;border-radius:999px;border:1px solid #232C3C;background:#06080C;color:#fff;font-size:15px;font-weight:600;cursor:pointer;box-shadow:0 18px 50px rgba(5,7,12,.35);transition:transform .2s}
.va-launch:hover{transform:translateY(-2px)}
body.nav-open .va-launch{display:none}
.va-mini{width:44px;height:44px;border-radius:50%;background:#06080C;display:block}
.va-shell{position:fixed;right:24px;bottom:24px;z-index:90;display:flex;gap:14px;align-items:flex-end;max-height:calc(100vh - 48px)}
.va-shell[hidden],.va-stage[hidden]{display:none}
.va-panel{width:404px;height:min(700px,calc(100vh - 48px));display:flex;flex-direction:column;border-radius:24px;background:var(--va-bg);border:1px solid var(--va-line);color:var(--va-tx);box-shadow:0 40px 110px rgba(5,7,12,.5);overflow:hidden}
.va-top{position:relative;height:236px;padding:14px;border-bottom:1px solid var(--va-line);display:flex;flex-direction:column;justify-content:space-between}
.va-bar{display:flex;justify-content:space-between;align-items:center;position:relative;z-index:2}
.va-book{display:inline-flex;align-items:center;gap:7px;font-size:13.5px;font-weight:600;padding:8px 13px;border-radius:999px;background:#fff;color:#0A0C10}
.va-ctl{display:flex;gap:6px}
.va-ic{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;border:1px solid #2A3548;background:transparent;color:var(--va-tx);cursor:pointer;font-size:17px}
.va-ic[aria-pressed="true"]{background:#1C2433;border-color:#9FB4D6}
.va-halo{position:absolute;inset:0;width:100%;height:100%;display:block}
.va-call{position:relative;z-index:2;display:flex;justify-content:center;margin-top:8px}
.va-talk{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border-radius:999px;border:0;background:#FF6B4A;color:#0A0C10;font:inherit;font-size:14.5px;font-weight:600;cursor:pointer;box-shadow:0 10px 30px rgba(255,107,74,.35);transition:transform .2s}
.va-talk:hover{transform:translateY(-2px)}
.va-live{display:flex;align-items:center;gap:12px}
.va-live[hidden],.va-talk[hidden]{display:none}
.va-timer{font-variant-numeric:tabular-nums;font-size:13.5px;color:#E9EEF5;min-width:40px;text-align:center}
.va-end{display:inline-flex;align-items:center;gap:7px;padding:9px 16px;border-radius:999px;border:0;background:#E5482A;color:#fff;font:inherit;font-size:14px;font-weight:600;cursor:pointer}
.va-mute[aria-pressed="true"]{background:#E5482A;border-color:#E5482A}
.va-m.live{border-style:dashed}
.va-state{position:relative;z-index:2;margin:auto 0 0;text-align:center;font-size:13px;color:var(--va-sub)}
.va-log{flex:1;overflow-y:auto;padding:16px 16px 6px;display:flex;flex-direction:column;gap:12px;scrollbar-width:thin}
.va-m{max-width:88%;font-size:14.5px;line-height:1.55;padding:11px 14px;border-radius:16px;white-space:pre-wrap}
.va-m.v{align-self:flex-start;background:#0F141E;border:1px solid var(--va-line);border-radius:16px 16px 16px 4px}
.va-m.u{align-self:flex-end;background:#1C2433;border-radius:16px 16px 4px 16px}
.va-m.p{opacity:1;color:var(--va-sub);font-style:italic}
.va-m a.va-lk{display:inline-flex;align-items:center;gap:6px;margin-top:10px;font-size:13.5px;font-weight:600;color:#9FB4D6}
.va-m .va-cta{display:inline-flex;align-items:center;gap:7px;margin-top:10px;font-size:13.5px;font-weight:600;padding:8px 13px;border-radius:999px;background:#FF6B4A;color:#0A0C10}
.va-m .va-thumb{display:none;margin-top:10px;border-radius:10px;border:1px solid var(--va-line);width:100%}
.va-dots{display:inline-flex;gap:4px}.va-dots i{width:6px;height:6px;border-radius:50%;background:#9FB4D6;animation:vgd 1s infinite}.va-dots i:nth-child(2){animation-delay:.15s}.va-dots i:nth-child(3){animation-delay:.3s}
@keyframes vgd{0%,100%{opacity:.3}50%{opacity:1}}
.va-chips{display:flex;flex-wrap:wrap;gap:6px;padding:4px 16px 10px}
.va-chips button{font-size:13px;padding:7px 12px;border-radius:999px;border:1px solid #2A3548;background:transparent;color:var(--va-tx);cursor:pointer}
.va-chips button:hover{border-color:#9FB4D6}
.va-in{display:flex;align-items:flex-end;gap:6px;margin:0 12px;padding:6px 6px 6px 14px;border-radius:18px;border:1px solid #2A3548;background:#0B0F18}
.va-in textarea{flex:1;resize:none;border:0;background:transparent;color:var(--va-tx);font:inherit;font-size:14.5px;line-height:1.45;padding:7px 0;max-height:110px;outline:none}
.va-in textarea::placeholder{color:#AEB8C8}
.va-mic,.va-send{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;border:0;cursor:pointer;font-size:18px}
.va-mic{background:#1C2433;color:#fff}.va-mic.on{background:#FF6B4A;color:#0A0C10}
.va-send{background:#fff;color:#0A0C10}
.va-legal{margin:0;padding:8px 16px 12px;font-size:11.5px;line-height:1.45;color:#AEB8C8}
.va-legal a{color:#C9D3E3;text-decoration:underline}
.va-stage{width:min(620px,calc(100vw - 480px));border-radius:24px;background:#fff;border:1px solid #E3E8EF;box-shadow:0 40px 110px rgba(5,7,12,.35);padding:14px;color:#0A0C10}
.va-sh{display:flex;justify-content:space-between;align-items:center;font-size:13.5px;font-weight:600;color:#2B3340}
.va-stage .va-ic{border-color:#DDE3EA;color:#0A0C10}
.va-fig{margin:10px 0 0}.va-fig img{display:block;width:100%;border-radius:14px;border:1px solid #E3E8EF}
.va-fig figcaption{font-size:13.5px;color:#2B3340;margin-top:10px}
.va-open{display:inline-flex;align-items:center;gap:6px;margin-top:10px;font-size:14px;font-weight:600;color:#2F5CA8}
@media (max-width:1000px){.va-stage{display:none!important}.va-m .va-thumb{display:block}}
@media (max-width:560px){.va-top{height:170px}.va-launch{right:16px;bottom:16px}.va-shell{inset:0;right:0;bottom:0;max-height:none}.va-panel{width:100vw;height:100dvh;border-radius:0;border:0}}
</style>

<script>
import { Engine, type Reply } from "../../scripts/assistant/engine";
import { opener, factsFor } from "../../scripts/assistant/knowledge";
import { Voice } from "../../scripts/assistant/voice";
import { Halo } from "../../scripts/assistant/halo";
import { sendLead, sendTranscript, leadsOn, mailto, type Line } from "../../scripts/assistant/leads";
import { askRemote, remoteOn } from "../../scripts/assistant/remote";
import { LiveCall, type CallState } from "../../scripts/assistant/live";
import { fixNames } from "../../scripts/assistant/names";
import { SCREENS } from "../../scripts/assistant/prompt";

const BOOK = (import.meta.env.PUBLIC_VIGIL_BOOKING_URL as string | undefined) || "mailto:support@relyxus.com?subject=" + encodeURIComponent("Book a Relyxus demo");
const KEY = "vigil.chat.v1";
const root = document.querySelector<HTMLElement>("[data-vg]")!;
const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
const shell = $("[data-va-shell]"), log = $("[data-va-log]"), chips = $("[data-va-chips]"), form = $<HTMLFormElement>("[data-va-form]");
const text = $<HTMLTextAreaElement>("[data-va-text]"), mic = $("[data-va-mic]"), speakerBtn = $("[data-va-speaker]"), stateEl = $("[data-va-state]");
const stage = $("[data-va-stage]"), img = $<HTMLImageElement>("[data-va-img]"), cap = $("[data-va-cap]"), href = $<HTMLAnchorElement>("[data-va-href]");
const launch = $("[data-va-open]");
$<HTMLAnchorElement>("[data-va-book]").href = BOOK;

const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
const voice = new Voice();
const engine = new Engine(location.pathname);
const lines: Line[] = [];
let talk = false, speaker = false, busy = false, leadSent = false;

type Saved = { lines: Line[]; lead: typeof engine.lead; open: boolean; speaker: boolean; leadSent: boolean };
function save(open = !shell.hidden) {
  try { sessionStorage.setItem(KEY, JSON.stringify({ lines: lines.slice(-40), lead: engine.lead, open, speaker, leadSent } satisfies Saved)); } catch {}
}

// Halos: a small one in the launcher, a large one in the panel.
const mini = new Halo(root.querySelector<HTMLCanvasElement>(".va-mini")!, 700, 0.34, "6,8,12");
const big = new Halo($<HTMLCanvasElement>("[data-va-halo]"), 2600, 0.235, "6,8,12");
big.dy = -22;
let last = performance.now();
function loop(now: number) {
  const dt = Math.min(0.05, (now - last) / 1000); last = now;
  let lv = voice.tick(now / 1000);
  if (call) {
    const st = call.tick(); lv = call.level;
    if (st !== "ended") { big.state = st; const sec = Math.floor((Date.now() - callStart) / 1000); timer.textContent = `${Math.floor(sec / 60)}:${String(sec % 60).padStart(2, "0")}`; stateEl.textContent = st === "speaking" ? "Vigil is speaking" : st === "thinking" ? "Thinking" : "Listening, go ahead"; }
  }
  if (!document.hidden) { if (shell.hidden) mini.frame(dt, 0); else big.frame(dt, lv); }
  if (!reduce) requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
if (reduce) { for (let i = 0; i < 40; i++) { mini.frame(0.016, 0); } }

function setState(s: "idle" | "listening" | "thinking" | "speaking") {
  big.state = s;
  stateEl.textContent = s === "listening" ? "Listening" : s === "thinking" ? "Thinking" : s === "speaking" ? "Speaking" : "Vigil, the Relyxus assistant";
}

function bubble(who: "u" | "v" | "p", body: string) {
  const d = document.createElement("div"); d.className = "va-m " + who; d.textContent = body;
  log.appendChild(d); log.scrollTop = log.scrollHeight; return d;
}

function renderChips(list?: string[]) {
  chips.innerHTML = "";
  (list || []).slice(0, 4).forEach((c) => {
    const b = document.createElement("button"); b.type = "button"; b.textContent = c;
    b.onclick = () => (c === "Pick a time" ? window.open(BOOK, "_blank", "noopener") : send(c));
    chips.appendChild(b);
  });
}

function showStage(s: NonNullable<Reply["show"]>) {
  img.src = s.src; img.alt = s.caption; cap.textContent = s.caption + ". The real product, in our demo workspace.";
  href.href = s.href || "/product"; stage.hidden = false;
}

function vigilSays(r: Reply) {
  const d = bubble("v", r.text);
  if (r.show) {
    showStage(r.show);
    const t = document.createElement("img"); t.className = "va-thumb"; t.src = r.show.src; t.alt = r.show.caption; d.appendChild(t);
  }
  if (r.link) { const a = document.createElement("a"); a.className = "va-lk"; a.href = r.link.href; a.textContent = r.link.label; d.appendChild(document.createElement("br")); d.appendChild(a); }
  if (r.book) { const a = document.createElement("a"); a.className = "va-cta"; a.href = BOOK; a.target = "_blank"; a.rel = "noopener"; a.textContent = "Pick a time"; d.appendChild(document.createElement("br")); d.appendChild(a); }
  renderChips(r.chips);
  lines.push({ who: "vigil", text: r.text, at: new Date().toISOString() });
}

async function send(raw: string) {
  const q = fixNames(raw.trim()); if (!q || busy) return;
  if (call) { bubble("u", q); lines.push({ who: "visitor", text: q, at: new Date().toISOString() }); renderChips([]); call.say(q); return; }
  busy = true; voice.stopSpeaking();
  bubble("u", q); renderChips([]);
  lines.push({ who: "visitor", text: q, at: new Date().toISOString() });
  setState("thinking");
  const dots = bubble("v", ""); dots.innerHTML = '<span class="va-dots" aria-label="Vigil is thinking"><i></i><i></i><i></i></span>';
  let r = engine.reply(q);
  await new Promise((ok) => setTimeout(ok, 450 + Math.min(900, r.text.length * 3)));
  if (r.unknown && remoteOn) {
    const hist = lines.slice(-7, -1).map((l) => ({ role: l.who === "vigil" ? "assistant" as const : "user" as const, content: l.text }));
    const a = await askRemote(q, factsFor([...(r.topics || []), "what"]), hist);
    if (a) r = { text: a, chips: ["Book a demo", "Talk to a person"] };
  }
  dots.remove();
  vigilSays(r);
  if (r.leadReady && !leadSent) {
    if (leadsOn) { leadSent = true; sendLead(engine.lead, lines); }
    else {
      const d = log.lastElementChild as HTMLElement, a = document.createElement("a");
      a.className = "va-cta"; a.href = mailto(engine.lead); a.textContent = "Send my details to the team";
      d.appendChild(document.createElement("br")); d.appendChild(a);
    }
  }
  save();
  busy = false;
  if (talk || speaker) {
    setState("speaking");
    await voice.speak(r.text);
  }
  setState("idle");
  if (talk) listen();
}

async function listen() {
  if (!voice.canListen) { bubble("v", "Your browser cannot take voice here. Chrome, Edge or Safari can, or you can type instead."); talk = false; mic.classList.remove("on"); return; }
  setState("listening");
  const p = bubble("p", "Listening");
  try {
    const said = fixNames(await voice.listen((t) => (p.textContent = fixNames(t) || "Listening")));
    p.remove();
    if (said) send(said);
    else { talk = false; mic.classList.remove("on"); setState("idle"); }
  } catch (e) {
    p.remove(); talk = false; mic.classList.remove("on"); setState("idle");
    if ((e as Error).message === "not-allowed") bubble("v", "I can't hear you, as the microphone is blocked. You can allow it in your browser, or type instead.");
  }
}

function open(first = true) {
  shell.hidden = false; launch.hidden = true;
  big.resize();
  if (first && !log.children.length) { const o = opener(location.pathname); vigilSays({ text: o.text, chips: o.chips }); }
  setTimeout(() => text.focus(), 50); save(true);
}
function close() {
  call?.end();
  voice.stopSpeaking(); voice.stopListening(); talk = false; mic.classList.remove("on");
  shell.hidden = true; launch.hidden = false; stage.hidden = true; save(false); launch.focus();
}

// Live voice calls (Gemini Live). Falls back to the browser's voice when the
// live service is not switched on.
const talkBtn = $("[data-va-talk]"), liveBar = $("[data-va-live]"), endBtn = $("[data-va-end]"), muteBtn = $("[data-va-mute]"), timer = $("[data-va-timer]");
let call: LiveCall | null = null, callStart = 0, youEl: HTMLElement | null = null, meEl: HTMLElement | null = null;

function liveBubble(who: "u" | "v", t: string, done: boolean) {
  let el = who === "u" ? youEl : meEl;
  if (!el) { el = bubble(who, t); el.classList.add("live"); if (who === "u") youEl = el; else meEl = el; }
  el.textContent = t; log.scrollTop = log.scrollHeight;
  if (done) { el.classList.remove("live"); lines.push({ who: who === "u" ? "visitor" : "vigil", text: t, at: new Date().toISOString() }); if (who === "u") youEl = null; else meEl = null; save(); }
}
function addTo(el: HTMLElement | null, node: HTMLElement) { const lastEl = log.lastElementChild as HTMLElement | null; const host = el || (lastEl && lastEl.classList.contains("v") ? lastEl : (meEl = bubble("v", ""), meEl.classList.add("live"), meEl)); host.appendChild(document.createElement("br")); host.appendChild(node); log.scrollTop = log.scrollHeight; }
const FREE = /@(gmail|googlemail|yahoo|hotmail|outlook|live|msn|icloud|me|aol|proton|protonmail|gmx|mail|yandex|zoho)\./i;

async function tool(name: string, a: Record<string, unknown>) {
  if (name === "show_screen") {
    const sc = SCREENS[String(a.screen)]; if (!sc) return { ok: false };
    showStage(sc); const t = document.createElement("img"); t.className = "va-thumb"; t.src = sc.src; t.alt = sc.caption; addTo(meEl, t);
    return { ok: true, shown: sc.caption };
  }
  if (name === "save_lead") {
    const email = String(a.email || "").trim().toLowerCase();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return { ok: false, reason: "That email address is not valid. Ask again." };
    if (FREE.test(email)) return { ok: false, reason: "That is a personal email. Ask once for a work email; if they insist, call save_lead again with the same address and interest set to the same value plus ' (personal email)'." , personal: true };
    Object.assign(engine.lead, { name: String(a.name || ""), email, company: String(a.company || ""), interest: String(a.interest || ""), sector: String(a.sector || engine.lead.sector || ""), regulators: String(a.regulators || engine.lead.regulators || "") });
    if (a.notes) engine.lead.questions.push(String(a.notes));
    if (leadsOn) { leadSent = true; await sendLead(engine.lead, lines); return { ok: true, saved: true }; }
    const l = document.createElement("a"); l.className = "va-cta"; l.href = mailto(engine.lead); l.textContent = "Send my details to the team"; addTo(meEl, l);
    return { ok: true, saved: false, say: "Ask them to press the Send my details to the team button that just appeared in the chat, which opens an email." };
  }
  if (name === "open_booking") {
    const l = document.createElement("a"); l.className = "va-cta"; l.href = BOOK; l.target = "_blank"; l.rel = "noopener"; l.textContent = "Pick a time"; addTo(meEl, l);
    return { ok: true, say: "A Pick a time button is now in the chat." };
  }
  if (name === "open_page") {
    const path = String(a.path || "/product"), l = document.createElement("a"); l.className = "va-lk"; l.href = path; l.textContent = "Open " + path.replace(/^\//, "").replace(/-/g, " "); addTo(meEl, l);
    return { ok: true };
  }
  return { ok: false };
}

function callUi(on: boolean) {
  talkBtn.hidden = on; liveBar.hidden = !on; mic.classList.toggle("on", on);
  mic.setAttribute("aria-label", on ? "End the call" : "Talk live with Vigil");
  if (!on) { setState("idle"); muteBtn.setAttribute("aria-pressed", "false"); muteBtn.innerHTML = '<i class="ti ti-microphone"></i>'; }
}

async function startCall() {
  if (call) return;
  if (shell.hidden) open(false);
  voice.stopSpeaking(); renderChips([]);
  const c = new LiveCall({
    state: (s: CallState, why?: string) => {
      if (s === "connecting") { stateEl.textContent = "Connecting"; big.state = "thinking"; }
      if (s === "ended") {
        call = null; callUi(false);
        if (why === "time") bubble("v", "That is the end of our call time. You can start another call, or keep typing here.");
        else if (why === "error") bubble("v", "The call dropped. You can start it again, or type here.");
      }
    },
    user: (t, done) => liveBubble("u", t, done),
    vigil: (t, done) => liveBubble("v", t, done),
    tool,
  });
  call = c; callStart = Date.now(); callUi(true);
  try { await c.start(location.pathname); }
  catch (e) {
    call = null; callUi(false);
    const m = (e as Error).message || "";
    if (/Permission|NotAllowed|denied/i.test(m) || (e as DOMException).name === "NotAllowedError") { bubble("v", "I can't hear you, as the microphone is blocked. Allow it in your browser and press Talk live again, or type here."); return; }
    if (m === "busy") { bubble("v", "You have started a lot of calls in a short time. Please type here, or try again in a little while."); return; }
    // Live voice is not switched on: use the browser's own voice instead.
    talk = true; mic.classList.add("on"); listen();
  }
}

launch.addEventListener("click", () => open());
$("[data-va-close]").addEventListener("click", close);
$("[data-va-unstage]").addEventListener("click", () => (stage.hidden = true));
document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !shell.hidden) close(); });
form.addEventListener("submit", (e) => { e.preventDefault(); const v = text.value; text.value = ""; text.style.height = ""; send(v); });
text.addEventListener("keydown", (e) => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); } });
text.addEventListener("input", () => { text.style.height = ""; text.style.height = Math.min(110, text.scrollHeight) + "px"; });
mic.addEventListener("click", () => {
  if (call) { call.end(); return; }
  if (talk) { talk = false; mic.classList.remove("on"); voice.stopListening(); voice.stopSpeaking(); setState("idle"); return; }
  startCall();
});
talkBtn.addEventListener("click", startCall);
endBtn.addEventListener("click", () => call?.end());
muteBtn.addEventListener("click", () => {
  if (!call) return; call.muted = !call.muted;
  muteBtn.setAttribute("aria-pressed", String(call.muted)); muteBtn.innerHTML = `<i class="ti ti-microphone${call.muted ? "-off" : ""}"></i>`;
});
speakerBtn.addEventListener("click", () => {
  speaker = !speaker; speakerBtn.setAttribute("aria-pressed", String(speaker));
  speakerBtn.innerHTML = `<i class="ti ti-volume${speaker ? "" : "-off"}"></i>`;
  if (!speaker) voice.stopSpeaking(); save();
});
document.addEventListener("click", (e) => {
  const t = (e.target as HTMLElement).closest<HTMLElement>("[data-ask]"); if (!t) return;
  e.preventDefault(); open(false); send(t.dataset.ask || "");
});
addEventListener("pagehide", () => { if (leadSent) sendTranscript(engine.lead, lines); });

// Pick up the conversation after moving to another page.
try {
  const s: Saved | null = JSON.parse(sessionStorage.getItem(KEY) || "null");
  if (s) {
    Object.assign(engine.lead, s.lead, { page: location.pathname }); leadSent = s.leadSent; speaker = s.speaker;
    if (speaker) { speakerBtn.setAttribute("aria-pressed", "true"); speakerBtn.innerHTML = '<i class="ti ti-volume"></i>'; }
    s.lines.forEach((l) => { bubble(l.who === "vigil" ? "v" : "u", l.text); lines.push(l); });
    if (s.open) open(false);
  }
} catch {}
</script>
