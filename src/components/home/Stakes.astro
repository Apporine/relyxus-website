---
// Section 7, the stakes: chaos to calm (locked). Verified UK figures over a wave of
// lines that glitches in coral, crosses the Relyxus marker and turns calm and green.
---
<section class="r-stk" aria-labelledby="stk-title">
  <div class="inner">
    <div class="guides" aria-hidden="true"></div>
    <h2 class="T" id="stk-title">Britain's biggest banks were down for over 800 hours in two years. <span>From March 2027, regulators will want to hear about the serious ones within a day.</span></h2>
    <div class="stage" aria-hidden="true"><canvas></canvas><span class="lab l">A bad night today</span><span class="lab r">The same night with Relyxus</span><div class="mark"><span>Relyxus</span></div></div>
    <div class="st"><div><b class="h1n">800+</b><span>hours of outages</span><small>At 9 major UK banks and building societies, January 2023 to February 2025</small></div><div><b>158</b><span>incidents, at least</span><small>Across the same 9 firms, in 26 months</small></div><div><b>56%</b><span>of online payments failed</span><small>During one bank's three day outage in early 2025</small></div><div class="g"><b>24 h</b><span>to send the first report</span><small>The new FCA and PRA rule, generally, from 18 March 2027</small></div></div>
    <div class="ans"><p><b>Relyxus</b> is built for that first day. <span>One owner in seconds, the cause with its evidence, a fix two people approve, and the report drafted as it happens.</span></p><a href="#one-night">See how it works <i class="ti ti-arrow-right" aria-hidden="true"></i></a></div>
    <p class="src">Sources: House of Commons Treasury Committee, March 2025, as reported by <a href="https://www.computerweekly.com/news/366620352/Big-bank-systems-down-for-over-800-hours-in-last-two-years-due-to-IT-outages" target="_blank" rel="noopener">Computer Weekly</a>. FCA PS26/2 and PRA PS7/26, summarised by <a href="https://www.tlt.com/insights-and-events/insight/fca-and-pra-publish-final-rules-on-operational-incident-reporting-firms-have-to-ready-by-18-march-2027" target="_blank" rel="noopener">TLT</a>.</p>
  </div>
</section>
<style is:global>
.r-stk{position:relative;overflow:hidden;padding:110px 0 64px;background:#0A0F1E;color:#fff}
.r-stk .inner{position:relative;max-width:1240px;margin:0 auto;padding:0 40px}
.r-stk .guides{position:absolute;inset:-110px 0 -64px;pointer-events:none;background:linear-gradient(90deg,rgba(255,255,255,.07) 0,rgba(255,255,255,.07) 1px,transparent 1px,transparent calc(100% - 1px),rgba(255,255,255,.07) calc(100% - 1px))}
.r-stk .T{position:relative;z-index:2;margin:0;font-family:var(--display);font-variation-settings:'opsz' 96;font-weight:500;font-size:clamp(32px,3.9vw,50px);line-height:1.08;letter-spacing:-.035em;max-width:960px;color:#fff}
.r-stk .T span{color:#9AA6B8}
.r-stk .stage{position:relative;height:400px;margin:14px -40px 0}
.r-stk .stage canvas{position:absolute;inset:0;width:100%;height:100%}
.r-stk .lab{position:absolute;top:22px;font-size:13px;font-weight:600;padding:5px 12px;border-radius:999px;white-space:nowrap}
.r-stk .lab.l{left:40px;color:#FFB08F;background:rgba(255,90,54,.12);border:1px solid rgba(255,90,54,.3)}
.r-stk .lab.r{right:40px;color:#8BE6BE;background:rgba(61,174,128,.12);border:1px solid rgba(61,174,128,.3)}
.r-stk .mark{position:absolute;top:0;bottom:0;left:52%;width:1px;background:linear-gradient(transparent,rgba(255,255,255,.35) 30%,rgba(255,255,255,.35) 70%,transparent)}
.r-stk .mark span{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:13px;font-weight:600;color:#0A0C10;background:#fff;padding:6px 13px;border-radius:999px;white-space:nowrap;box-shadow:0 10px 30px rgba(0,0,0,.4)}
.r-stk .st{position:relative;z-index:2;display:grid;grid-template-columns:1.35fr 1fr 1fr 1fr;gap:26px}
.r-stk .st div{border-top:1px solid rgba(255,255,255,.16);padding-top:18px}
.r-stk .st b{display:block;font-family:var(--display);font-variation-settings:'opsz' 96;font-weight:400;font-size:60px;line-height:1;letter-spacing:-.045em;background:linear-gradient(90deg,#FFB08F,#FF5A36);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;font-variant-numeric:tabular-nums}
.r-stk .st div:first-child b{font-size:88px}
.r-stk .st div.g b{background-image:linear-gradient(90deg,#BDEBD6,#3DAE80)}
.r-stk .st span{display:block;font-size:15px;color:#E9EEF5;margin-top:10px;font-weight:500;line-height:1.4}
.r-stk .st small{display:block;font-size:13px;color:#9AA6B8;margin-top:4px;line-height:1.45}
.r-stk .ans{position:relative;z-index:2;margin-top:40px;display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center;padding:26px 28px 26px 32px;border-radius:14px;overflow:hidden;background:linear-gradient(100deg,rgba(61,174,128,.16),rgba(13,17,28,.6) 60%);border:1px solid rgba(61,174,128,.35);box-shadow:0 0 60px rgba(61,174,128,.12)}
.r-stk .ans:before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:linear-gradient(#BDEBD6,#3DAE80);box-shadow:0 0 24px 4px rgba(61,174,128,.55)}
.r-stk .ans p{margin:0;font-family:var(--display);font-variation-settings:'opsz' 96;font-size:26px;line-height:1.3;letter-spacing:-.02em;color:#fff}
.r-stk .ans p b{color:#8BE6BE;font-weight:500}.r-stk .ans p span{color:#C9CED6}
.r-stk .ans a{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:11px 20px;font-size:15px;font-weight:500;background:#fff;color:#0A0C10;white-space:nowrap}
.r-stk .src{position:relative;z-index:2;margin-top:24px;font-size:12.5px;color:#9AA6B8;line-height:1.6}
.r-stk .src a{color:#C9CED6;text-decoration:underline;text-underline-offset:2px}
@media (max-width:860px){.r-stk .st{grid-template-columns:1fr 1fr}.r-stk .ans{grid-template-columns:1fr}.r-stk .inner{padding:0 24px}.r-stk .stage{margin:14px -24px 0;height:300px}.r-stk .lab.l{left:24px}.r-stk .lab.r{right:24px}}
</style>
<script>
const root = document.querySelector<HTMLElement>(".r-stk")!;
const cv = root.querySelector("canvas")!, stage = root.querySelector<HTMLElement>(".stage")!, mk = root.querySelector<HTMLElement>(".mark")!, h1 = root.querySelector<HTMLElement>(".h1n")!;
const DPR = Math.min(2, devicePixelRatio || 1);
const hash = (n: number) => { const s = Math.sin(n * 127.1) * 43758.5453; return s - Math.floor(s); };
let split = 0.52, target = 0.52;
stage.addEventListener("pointermove", (e) => { const r = stage.getBoundingClientRect(); target = Math.min(0.85, Math.max(0.15, (e.clientX - r.left) / r.width)); });
stage.addEventListener("pointerleave", () => (target = 0.52));
const mix = (a: number[], b: number[], k: number) => a.map((v, i) => Math.round(v + (b[i] - v) * k));
function draw(t: number) {
  const w = cv.clientWidth, h = cv.clientHeight; if (!w) return;
  if (cv.width !== Math.round(w * DPR) || cv.height !== Math.round(h * DPR)) { cv.width = w * DPR; cv.height = h * DPR; }
  const x = cv.getContext("2d")!; x.setTransform(DPR, 0, 0, DPR, 0, 0); x.clearRect(0, 0, w, h);
  split += (target - split) * 0.08; mk.style.left = split * 100 + "%";
  x.globalCompositeOperation = "lighter"; const N = 60, gseg = Math.floor(t * 2);
  for (let i = 0; i < N; i++) { const u = i / N; let last: number[] | null = null;
    for (let px = 0; px <= w; px += 4) { const s = px / w; const env = Math.sin(Math.PI * Math.min(1, Math.max(0, (s - 0.01) / 0.98)));
      const calm = Math.min(1, Math.max(0, (s - split + 0.06) / 0.12));
      let y = h * 0.5 + Math.sin(s * 3 + t * 0.35 + u * 3.2) * h * (0.08 + 0.16 * u) * env + (u - 0.5) * (230 - 170 * calm) * env * (h / 360);
      const cell = Math.floor(s * 30); const g = hash(cell * 31 + gseg); const chaos = 1 - calm;
      if (g > 0.6) y += (hash(cell * 7 + i + gseg) - 0.5) * 130 * env * chaos; y += Math.sin(px * 0.09 + t * 6 + i) * 7 * chaos * env;
      if (last) { const c = mix([255, 90, 54], [61, 174, 128], calm); const c2 = mix(c, calm > 0.5 ? [189, 235, 214] : [255, 176, 143], u * 0.6);
        x.strokeStyle = `rgba(${c2},${0.13 + 0.1 * Math.sin(u * Math.PI)})`; x.lineWidth = 1; x.beginPath(); x.moveTo(last[0], last[1]); x.lineTo(px, y); x.stroke(); }
      last = [px, y]; } }
  x.globalCompositeOperation = "source-over";
}
let count = 0, last = 0, vis = false, started = false;
new IntersectionObserver((e) => { vis = e[0].isIntersecting; if (vis) started = true; }).observe(root);
function loop(ts: number) { const t = ts / 1000, dt = Math.min(0.05, t - last || 0.016); last = t;
  if (vis) { draw(t); if (started && count < 800) { count = Math.min(800, count + dt * 420); h1.textContent = Math.floor(count) + (count >= 800 ? "+" : ""); } }
  requestAnimationFrame(loop); }
if (matchMedia("(prefers-reduced-motion: reduce)").matches) draw(3); else { h1.textContent = "0"; requestAnimationFrame(loop); }
</script>
