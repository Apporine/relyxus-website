---
import Page from "../../layouts/Page.astro";
const days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
const rows: [string, [number, number, string][]][] = [["Payments primary", [[0, 3, "Sarah Mitchell"], [3, 5, "Emma Clarke"], [5, 7, "Alex Evans"]]], ["Payments secondary", [[0, 2, "Mark Clarke"], [2, 4, "Daniel Hughes"], [4, 7, "Mark Clarke"]]], ["Identity primary", [[0, 4, "Sarah Mitchell"], [4, 6, "Laura Bennett"], [6, 7, "James Walker"]]]];
---
<Page title="Respond | Relyxus" description="Command centre, war room, paging and on call: the right person in the room, and everyone seeing the same numbers." path="/product/respond" tone="dark" current="/product">
  <section class="k-sec k-dark rs-hero">
    <div class="wrap"><span class="k-tag"><i class="d"></i>Respond</span><h1 class="k-h1" style="margin-top:16px;max-width:920px">One page for the whole bank <span>when it goes wrong.</span></h1>
      <div class="shot"><video muted playsinline loop autoplay preload="metadata" poster="/media/one-night/command-mid.jpg" src="/media/one-night/command.mp4"></video></div><p class="k-note">Recorded in the demo workspace, sample data.</p></div>
  </section>
  <section class="k-sec k-navy rs-radar">
    <div class="wrap k-split"><div><h2 class="k-h2">It keeps calling <span>until someone answers.</span></h2><p class="k-lede">Slack, text, email, then a real phone call. If the primary does not answer in five minutes, the next person is called, and quiet hours are kept unless it is a Severity 1.</p></div>
      <div class="radar" aria-hidden="true"><div class="sweep"></div><span class="p p1"><b>ST</b>Primary</span><span class="p p2"><b>EC</b>Backup</span><span class="p p3"><b>RK</b>Lead, asleep</span></div></div>
  </section>
  <section class="k-sec k-white rs-rota">
    <div class="wrap"><h2 class="k-h2">Rotas with no gaps, <span>and proof there were none.</span></h2>
      <div class="cal k-card"><div class="hd"><span></span>{days.map((d) => <em>{d}</em>)}</div>{rows.map(([n, sh]) => <div class="row"><b>{n}</b><div class="lane">{sh.map(([a, z, who]) => <span style={`left:${(a / 7) * 100}%;width:${((z - a) / 7) * 100}%`}>{who}</span>)}</div></div>)}<div class="gap"><i class="ti ti-circle-check"></i>No gaps this week. 4 of 4 schedules covered.</div></div></div>
  </section>
  <section class="k-sec k-mist rs-room">
    <div class="wrap k-split"><div><h2 class="k-h2">Everyone in the room <span>sees the same numbers.</span></h2><p class="k-lede">Failed transactions, money at risk, the regulator clock and who has been paged, live on one screen for everyone on the call.</p></div>
      <div class="screen k-card"><img src="/media/one-night/incident-mid.jpg" alt="The Relyxus war room for incident INC-2041" /><span class="cur c1">Sarah</span><span class="cur c2">Daniel</span><span class="cur c3">Emma</span></div></div>
  </section>
  <section class="k-sec k-dark rs-baton">
    <div class="wrap"><h2 class="k-h2">Shift changes <span>without losing the thread.</span></h2>
      <div class="relay"><div class="who k-card"><b>Sarah Mitchell</b><small>Ends 08:00</small><ul><li>INC-2041 resolved, review booked</li><li>Settlement lag, watching</li></ul></div><div class="track"><i class="baton"></i></div><div class="who k-card"><b>Emma Clarke</b><small>Starts 08:00</small><ul><li>Handover read and accepted</li><li>2 open items, owned</li></ul></div></div></div>
  </section>
</Page>
<style is:global>
.rs-hero{padding:90px 0 100px}.rs-hero .shot{margin-top:44px;border-radius:18px;overflow:hidden;border:1px solid #1E2430;box-shadow:0 60px 120px rgba(0,0,0,.6)}.rs-hero video{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}
.rs-radar .radar{position:relative;width:min(420px,100%);aspect-ratio:1;justify-self:center;border-radius:50%;background:repeating-radial-gradient(circle,transparent 0 58px,#232B3A 58px 59px);border:1px solid #2C3546;overflow:hidden}
.rs-radar .sweep{position:absolute;inset:0;background:conic-gradient(from 0deg,rgba(61,174,128,.45),transparent 60deg);animation:rs-sweep 4s linear infinite}
@keyframes rs-sweep{to{transform:rotate(360deg)}}
.rs-radar .p{position:absolute;display:flex;flex-direction:column;align-items:center;gap:4px;font-size:12.5px;color:#C9D1DC}
.rs-radar .p b{width:42px;height:42px;border-radius:50%;background:#141A26;border:2px solid #3A4458;display:grid;place-items:center;color:#fff;font-size:13px}
.rs-radar .p1{left:58%;top:22%}.rs-radar .p1 b{border-color:#3DAE80;box-shadow:0 0 0 8px rgba(61,174,128,.2);animation:r-ping 1.6s infinite}
.rs-radar .p2{left:22%;top:48%}.rs-radar .p3{left:56%;top:66%}.rs-radar .p3 b{opacity:.55}
.rs-rota .cal{margin-top:40px;padding:20px}
.rs-rota .hd,.rs-rota .row{display:grid;grid-template-columns:190px 1fr;align-items:center;gap:14px}
.rs-rota .hd{grid-template-columns:190px repeat(7,1fr)}.rs-rota .hd em{font-style:normal;font-size:13px;color:var(--muted-2);text-align:center}
.rs-rota .row{padding:14px 0;border-top:1px solid var(--line-2)}.rs-rota .row b{font-size:15px}
.rs-rota .lane{position:relative;height:36px}
.rs-rota .lane span{position:absolute;top:0;bottom:0;margin:0 3px;border-radius:9px;background:#EEF3FB;border:1px solid #D3DEEF;font-size:13.5px;display:flex;align-items:center;padding:0 10px;white-space:nowrap;overflow:hidden}
.rs-rota .row:nth-child(3) .lane span{background:#F1F9F5;border-color:#CDE9DC}.rs-rota .row:nth-child(4) .lane span{background:#FFF4F0;border-color:#F8D9CE}
.rs-rota .gap{display:flex;align-items:center;gap:8px;margin-top:14px;font-size:15px;font-weight:600;color:#17694A}
.rs-room .screen{position:relative;overflow:hidden;padding:0}.rs-room img{display:block;width:100%}
.rs-room .cur{position:absolute;font-size:12.5px;font-weight:600;color:#fff;padding:3px 8px 3px 16px;border-radius:999px;animation:rs-move 6s ease-in-out infinite alternate}
.rs-room .cur::before{content:"";position:absolute;left:-6px;top:-8px;border:8px solid transparent;border-left-color:inherit;transform:rotate(-30deg)}
.rs-room .c1{background:#E5482A;left:20%;top:30%}.rs-room .c2{background:#5C4EE5;left:60%;top:55%;animation-delay:-2s}.rs-room .c3{background:#17694A;left:40%;top:70%;animation-delay:-4s}
@keyframes rs-move{to{transform:translate(60px,-30px)}}
.rs-baton .relay{display:grid;grid-template-columns:1fr 1.2fr 1fr;gap:16px;align-items:center;margin-top:44px}
.rs-baton .who{padding:22px}.rs-baton .who b{font-size:19px}.rs-baton .who small{display:block;color:#9FB4D6;margin-top:2px}.rs-baton ul{margin:12px 0 0;padding-left:18px;color:#C9D1DC;line-height:1.8}
.rs-baton .track{position:relative;height:4px;border-radius:2px;background:linear-gradient(90deg,#FF6B4A,#3DAE80)}
.rs-baton .baton{position:absolute;top:-14px;width:60px;height:32px;border-radius:16px;background:#fff;box-shadow:0 0 30px rgba(255,255,255,.4);animation:rs-pass 3.5s ease-in-out infinite alternate}
@keyframes rs-pass{from{left:0}to{left:calc(100% - 60px)}}
@media (max-width:900px){.rs-baton .relay{grid-template-columns:1fr}.rs-rota .hd{display:none}.rs-rota .row{grid-template-columns:1fr}}
</style>
