---
// Vigil, the website assistant (15 Nov 2026). A Halo launcher at the bottom
// right opens a panel where visitors type or talk. Vigil answers from the
// published facts, shows real product screens beside the chat, asks a few
// qualifying questions, takes name, work email and company for a demo, a
// replay, a quote or a person, and books a meeting. Setup: agent/README.md.
---
<div class="va" data-vg>
  <button class="va-launch" type="button" aria-haspopup="dialog" aria-controls="va-panel" data-va-open>
    <canvas class="va-mini" width="44" height="44" aria-hidden="true"></canvas>
    <span>Ask Vigil</span>
  </button>

  <div class="va-shell" hidden data-va-shell>
    <aside class="va-stage" hidden data-va-stage aria-label="Shared by Vigil">
      <div class="va-sh"><span>Shared by Vigil</span><button type="button" class="va-ic" aria-label="Close shared screen" data-va-unstage><i class="ti ti-x"></i></button></div>
      <figure class="va-fig"><img alt="" data-va-img /><figcaption data-va-cap></figcaption></figure>
      <a class="va-open" href="/" data-va-href>Open this page <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a>
    </aside>

    <section class="va-panel" id="va-panel" role="dialog" aria-modal="false" aria-label="Chat with Vigil">
      <header class="va-top">
        <div class="va-orb">
          <canvas class="va-halo" aria-hidden="true" data-va-halo></canvas>
          <button type="button" class="va-ic va-x" aria-label="Close chat" title="Close" data-va-close><i class="ti ti-x"></i></button>
          <p class="va-state" aria-live="polite" data-va-state>Vigil, the Relyxus assistant</p>
        </div>
        <a class="va-book" href="/demo#book" target="_blank" rel="noopener" data-va-book>Book a meeting</a>
        <div class="va-av">
          <button type="button" class="va-tg" aria-pressed="false" data-va-mic><i class="ti ti-microphone-off" aria-hidden="true"></i><span>Mic</span></button>
          <button type="button" class="va-tg" aria-pressed="false" data-va-speaker><i class="ti ti-volume-off" aria-hidden="true"></i><span>Speaker</span></button>
        </div>
      </header>

      <div class="va-log" role="log" aria-live="polite" data-va-log></div>
      <p class="va-sug" data-va-sug hidden>Suggested topics</p>
      <div class="va-chips" data-va-chips></div>

      <form class="va-in" data-va-form>
        <label class="sr-only" for="va-text">Message Vigil</label>
        <textarea id="va-text" rows="1" placeholder="Type here" maxlength="600" data-va-text></textarea>
        <button type="submit" class="va-send" aria-label="Send"><i class="ti ti-arrow-up"></i></button>
      </form>
      <p class="va-legal">Vigil is an AI assistant and can make mistakes. Chats and voice are processed by Google to run Vigil. If you share your name and email, we keep them with this chat so the team can reply. <a href="/privacy">Privacy notice</a></p>
    </section>
  </div>
</div>

<style is:global>
.va{--va-bg:#06080C;--va-line:#1E2635;--va-tx:#E9EEF5;--va-sub:#C9D3E3;font-family:var(--body)}
.va-launch{position:fixed;right:24px;bottom:24px;z-index:80;display:flex;align-items:center;gap:10px;padding:6px 18px 6px 6px;border-radius:999px;border:1px solid #232C3C;background:#06080C;color:#fff;font-size:15px;font-weight:600;cursor:pointer;box-shadow:0 18px 50px rgba(5,7,12,.35);transition:transform .2s}
.va-launch:hover{transform:translateY(-2px)}
body.nav-open .va-launch{display:none}
.va-mini{width:44px;height:44px;border-radius:50%;background:#06080C;display:block}
.va-shell{position:fixed;right:24px;bottom:24px;z-index:90;display:flex;gap:14px;align-items:flex-end;max-height:calc(100vh - 48px)}
.va-shell[hidden],.va-stage[hidden]{display:none}
.va-panel{width:404px;height:min(700px,calc(100vh - 48px));display:flex;flex-direction:column;border-radius:24px;background:var(--va-bg);border:1px solid var(--va-line);color:var(--va-tx);box-shadow:0 40px 110px rgba(5,7,12,.5);overflow:hidden}
.va-ic{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;border:1px solid #2A3548;background:transparent;color:var(--va-tx);cursor:pointer;font-size:17px}
.va-ic[aria-pressed="true"]{background:#1C2433;border-color:#9FB4D6}
.va-m.live{border-style:dashed}
.va-top{padding:10px 10px 4px;border-bottom:1px solid var(--va-line)}
.va-orb{position:relative;height:178px;border-radius:18px;overflow:hidden;background:radial-gradient(60% 70% at 50% 45%,#121a2a,#06080C 70%)}
.va-halo{position:absolute;inset:0;width:100%;height:100%;display:block}
.va-x{position:absolute;right:10px;top:10px;z-index:2;background:rgba(6,8,12,.6)}
.va-state{position:absolute;left:0;right:0;bottom:10px;z-index:2;margin:0;text-align:center;font-size:12.5px;color:var(--va-sub)}
.va-book{display:flex;justify-content:center;margin-top:10px;padding:11px;border-radius:999px;background:#FF6B4A;color:#0A0C10;font-size:14.5px;font-weight:600;transition:filter .2s}
.va-book:hover{filter:brightness(1.06)}
.va-av{display:flex;justify-content:center;gap:28px;padding:10px 0 4px}
.va-tg{display:flex;flex-direction:column;align-items:center;gap:4px;border:0;background:transparent;color:var(--va-tx);font:inherit;font-size:12px;cursor:pointer}
.va-tg i{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;border:1px solid #2A3548;font-size:20px;transition:background .2s,border-color .2s,box-shadow .2s}
.va-tg:hover i{border-color:#9FB4D6}
.va-tg[aria-pressed="true"] i{background:#FF6B4A;border-color:#FF6B4A;color:#0A0C10;box-shadow:0 0 0 6px rgba(255,107,74,.18)}
.va-sug{margin:0;padding:2px 16px 4px;font-size:11.5px;color:#AEB8C8}
.va-sug[hidden]{display:none}
.va-log{flex:1;overflow-y:auto;padding:16px 16px 6px;display:flex;flex-direction:column;gap:12px;scrollbar-width:thin}
.va-m{max-width:88%;font-size:14.5px;line-height:1.55;padding:11px 14px;border-radius:16px;white-space:pre-wrap}
.va-m.v{align-self:flex-start;background:#0F141E;border:1px solid var(--va-line);border-radius:16px 16px 16px 4px}
.va-m.u{align-self:flex-end;background:#1C2433;border-radius:16px 16px 4px 16px}
.va-m.p{opacity:1;color:var(--va-sub);font-style:italic}
.va-m a.va-lk{display:inline-flex;align-items:center;gap:6px;margin-top:10px;font-size:13.5px;font-weight:600;color:#9FB4D6}
.va-m .va-cta{display:inline-flex;align-items:center;gap:7px;margin-top:10px;font-size:13.5px;font-weight:600;padding:8px 13px;border-radius:999px;background:#FF6B4A;color:#0A0C10}
.va-m .va-thumb{display:none;margin-top:10px;border-radius:10px;border:1px solid var(--va-line);width:100%}
.va-dots{display:inline-flex;gap:4px}.va-dots i{width:6px;height:6px;border-radius:50%;background:#9FB4D6;animation:vgd 1s infinite}.va-dots i:nth-child(2){animation-delay:.15s}.va-dots i:nth-child(3){animation-delay:.3s}
@keyframes vgd{0%,100%{opacity:.3}50%{opacity:1}}
.va-chips{display:flex;flex-wrap:wrap;gap:6px;padding:4px 16px 10px}
.va-chips button{font-size:13px;padding:7px 12px;border-radius:999px;border:1px solid #2A3548;background:transparent;color:var(--va-tx);cursor:pointer}
.va-chips button:hover{border-color:#9FB4D6}
.va-in{display:flex;align-items:flex-end;gap:6px;margin:0 12px;padding:6px 6px 6px 14px;border-radius:18px;border:1px solid #2A3548;background:#0B0F18}
.va-in textarea{flex:1;resize:none;border:0;background:transparent;color:var(--va-tx);font:inherit;font-size:14.5px;line-height:1.45;padding:7px 0;max-height:110px;outline:none}
.va-in textarea::placeholder{color:#AEB8C8}.va-mic.on{background:#FF6B4A;color:#0A0C10}
.va-send{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;border:0;cursor:pointer;font-size:18px;background:#fff;color:#0A0C10}
.va-legal{margin:0;padding:8px 16px 12px;font-size:11.5px;line-height:1.45;color:#AEB8C8}
.va-legal a{color:#C9D3E3;text-decoration:underline}
.va-stage{width:min(620px,calc(100vw - 480px));border-radius:24px;background:#fff;border:1px solid #E3E8EF;box-shadow:0 40px 110px rgba(5,7,12,.35);padding:14px;color:#0A0C10}
.va-sh{display:flex;justify-content:space-between;align-items:center;font-size:13.5px;font-weight:600;color:#2B3340}
.va-stage .va-ic{border-color:#DDE3EA;color:#0A0C10}
.va-fig{margin:10px 0 0}.va-fig img{display:block;width:100%;border-radius:14px;border:1px solid #E3E8EF}
.va-fig figcaption{font-size:13.5px;color:#2B3340;margin-top:10px}
.va-open{display:inline-flex;align-items:center;gap:6px;margin-top:10px;font-size:14px;font-weight:600;color:#2F5CA8}
@media (max-width:1000px){.va-stage{display:none!important}.va-m .va-thumb{display:block}}
@media (max-width:560px){.va-orb{height:140px}.va-launch{right:16px;bottom:16px}.va-shell{inset:0;right:0;bottom:0;max-height:none}.va-panel{width:100vw;height:100dvh;border-radius:0;border:0}}
</style>

<script>
import { Engine, type Reply } from "../../scripts/assistant/engine";
import { opener } from "../../scripts/assistant/knowledge";
import { Voice } from "../../scripts/assistant/voice";
import { Halo } from "../../scripts/assistant/halo";
import { sendLead, sendTranscript, leadsOn, mailto, type Line } from "../../scripts/assistant/leads";
import { LiveCall, type CallState } from "../../scripts/assistant/live";
import { fixNames } from "../../scripts/assistant/names";
import { SCREENS } from "../../scripts/assistant/prompt";

// How Vigil works (16 Nov 2026), like a person on a call:
// Speaker on: Vigil's voice is live and she greets you out loud.
// Mic on: you talk to her live; it is off until you switch it on.
// Typing works at any time. One brain (Gemini) answers text and voice;
// without it, the built in backup answers and the browser's voice speaks.

const BOOK = (import.meta.env.PUBLIC_VIGIL_BOOKING_URL as string | undefined) || "mailto:support@relyxus.com?subject=" + encodeURIComponent("Book a Relyxus demo");
const KEY = "vigil.chat.v2";
const root = document.querySelector<HTMLElement>("[data-vg]")!;
const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
const shell = $("[data-va-shell]"), log = $("[data-va-log]"), chips = $("[data-va-chips]"), sug = $("[data-va-sug]"), form = $<HTMLFormElement>("[data-va-form]");
const text = $<HTMLTextAreaElement>("[data-va-text]"), micBtn = $("[data-va-mic]"), spkBtn = $("[data-va-speaker]"), stateEl = $("[data-va-state]");
const stage = $("[data-va-stage]"), img = $<HTMLImageElement>("[data-va-img]"), cap = $("[data-va-cap]"), href = $<HTMLAnchorElement>("[data-va-href]");
const launch = $("[data-va-open]");
$<HTMLAnchorElement>("[data-va-book]").href = BOOK;

const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
const voice = new Voice();
const engine = new Engine(location.pathname);
const lines: Line[] = [];
let speakerOn = false, micOn = false, busy = false, leadSent = false, listening = false;
let brain: "unknown" | "gemini" | "backup" = "unknown";
let liveOk: boolean | null = null;
let call: LiveCall | null = null, youEl: HTMLElement | null = null, meEl: HTMLElement | null = null;
const FREE = /@(gmail|googlemail|yahoo|hotmail|outlook|live|msn|icloud|me|aol|proton|protonmail|gmx|mail|yandex|zoho)\./i;

type Saved = { lines: Line[]; lead: typeof engine.lead; open: boolean; leadSent: boolean };
function save(open = !shell.hidden) {
  try { sessionStorage.setItem(KEY, JSON.stringify({ lines: lines.slice(-40), lead: engine.lead, open, leadSent } satisfies Saved)); } catch {}
}

// The Halo
const mini = new Halo(root.querySelector<HTMLCanvasElement>(".va-mini")!, 700, 0.34, "6,8,12");
const big = new Halo($<HTMLCanvasElement>("[data-va-halo]"), 2600, 0.31, "6,8,12");
big.dy = -10;
let last = performance.now();
const STATE_TEXT: Record<string, string> = { idle: "Vigil, the Relyxus assistant", listening: "Listening", thinking: "Thinking", speaking: "Speaking" };
function loop(now: number) {
  const dt = Math.min(0.05, (now - last) / 1000); last = now;
  let lv = voice.tick(now / 1000);
  if (call) {
    const st = call.tick(); lv = call.level;
    if (st !== "ended" && st !== "connecting") { big.state = st === "idle" ? "idle" : st; stateEl.textContent = st === "idle" ? "Speaker on. Switch on your mic to talk" : STATE_TEXT[st]; }
  }
  if (!document.hidden) { if (shell.hidden) mini.frame(dt, 0); else big.frame(dt, lv); }
  if (!reduce) requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
if (reduce) { for (let i = 0; i < 40; i++) mini.frame(0.016, 0); }
function setState(s: "idle" | "listening" | "thinking" | "speaking") { if (call) return; big.state = s; stateEl.textContent = STATE_TEXT[s]; }

// Messages
function bubble(who: "u" | "v" | "p", body: string) {
  const d = document.createElement("div"); d.className = "va-m " + who; d.textContent = body;
  log.appendChild(d); log.scrollTop = log.scrollHeight; return d;
}
function record(who: Line["who"], t: string) { lines.push({ who, text: t, at: new Date().toISOString() }); save(); }
function renderChips(list?: string[]) {
  chips.innerHTML = ""; sug.hidden = !(list && list.length);
  (list || []).slice(0, 4).forEach((c) => {
    const b = document.createElement("button"); b.type = "button"; b.textContent = c;
    b.onclick = () => send(c);
    chips.appendChild(b);
  });
}
function attach(host: HTMLElement | null, node: HTMLElement) {
  const lastEl = log.lastElementChild as HTMLElement | null;
  const h = host || (lastEl && lastEl.classList.contains("v") ? lastEl : bubble("v", ""));
  h.appendChild(document.createElement("br")); h.appendChild(node); log.scrollTop = log.scrollHeight;
}
function showScreen(key: string, host: HTMLElement | null) {
  const sc = SCREENS[key]; if (!sc) return false;
  img.src = sc.src; img.alt = sc.caption; cap.textContent = sc.caption + ". The real product, in our demo workspace.";
  href.href = sc.href; stage.hidden = false;
  const t = document.createElement("img"); t.className = "va-thumb"; t.src = sc.src; t.alt = sc.caption; attach(host, t);
  return true;
}
function cta(label: string, url: string, host: HTMLElement | null, blank = false) {
  const a = document.createElement("a"); a.className = "va-cta"; a.href = url; a.textContent = label;
  if (blank) { a.target = "_blank"; a.rel = "noopener"; }
  attach(host, a);
}
function pageLink(path: string, host: HTMLElement | null) {
  const a = document.createElement("a"); a.className = "va-lk"; a.href = path;
  a.textContent = "Open " + (path.replace(/^\//, "").replace(/-/g, " ") || "home"); attach(host, a);
}
function leadDone(lead: Record<string, string>, saved: boolean, host: HTMLElement | null) {
  Object.assign(engine.lead, lead);
  if (!saved) cta("Send my details to the team", mailto(engine.lead), host); else leadSent = true;
}

// Speaking with the browser's voice, only when Gemini Live is not available
async function speakBackup(t: string) { if (!speakerOn || call) return; setState("speaking"); await voice.speak(t); setState("idle"); if (micOn) listenBackup(); }

// Text messages
async function send(raw: string) {
  const q = fixNames(raw.trim()); if (!q || busy) return;
  renderChips([]);
  if (call) { bubble("u", q); record("visitor", q); call.say(q); return; }
  busy = true; voice.stopSpeaking();
  bubble("u", q); record("visitor", q);
  setState("thinking");
  const dots = bubble("v", ""); dots.innerHTML = '<span class="va-dots" aria-label="Vigil is thinking"><i></i><i></i><i></i></span>';
  let said = "";
  if (brain !== "backup") {
    try {
      const r = await fetch("/api/vigil-chat", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ history: lines.slice(-24), page: location.pathname }) });
      if (r.status === 503 || r.status === 404 || r.status === 405) brain = "backup";
      else if (r.ok) {
        brain = "gemini";
        const j = await r.json() as { text: string; actions: { type: string; screen?: string; path?: string; saved?: boolean; lead?: Record<string, string> }[] };
        dots.remove();
        said = j.text || "I have put that in the chat for you.";
        const el = bubble("v", said);
        for (const a of j.actions || []) {
          if (a.type === "screen" && a.screen) showScreen(a.screen, el);
          if (a.type === "booking") cta("Pick a time", BOOK, el, true);
          if (a.type === "page" && a.path) pageLink(a.path, el);
          if (a.type === "lead" && a.lead) leadDone(a.lead, !!a.saved, el);
        }
        record("vigil", said);
      }
    } catch { /* fall through to the backup */ }
  }
  if (!said) {
    await new Promise((ok) => setTimeout(ok, 350));
    const r = engine.reply(q);
    dots.remove();
    said = r.text;
    backupSays(r);
  }
  busy = false;
  setState("idle");
  speakBackup(said);
}

function backupSays(r: Reply) {
  const d = bubble("v", r.text);
  if (r.show) { img.src = r.show.src; img.alt = r.show.caption; cap.textContent = r.show.caption + ". The real product, in our demo workspace."; href.href = r.show.href || "/product"; stage.hidden = false; const t = document.createElement("img"); t.className = "va-thumb"; t.src = r.show.src; t.alt = r.show.caption; attach(d, t); }
  if (r.link) pageLink(r.link.href, d);
  if (r.book) cta("Pick a time", BOOK, d, true);
  if (r.leadReady && !leadSent) { if (leadsOn) { leadSent = true; sendLead(engine.lead, lines); } else cta("Send my details to the team", mailto(engine.lead), d); }
  renderChips(r.chips);
  record("vigil", r.text);
}

// Live voice
function liveBubble(who: "u" | "v", t: string, done: boolean) {
  let el = who === "u" ? youEl : meEl;
  if (!el) { el = bubble(who, t); el.classList.add("live"); if (who === "u") youEl = el; else meEl = el; }
  el.firstChild ? (el.firstChild.textContent = t) : (el.textContent = t);
  log.scrollTop = log.scrollHeight;
  if (done) { el.classList.remove("live"); record(who === "u" ? "visitor" : "vigil", t); if (who === "u") youEl = null; else meEl = null; }
}
async function tool(name: string, a: Record<string, unknown>) {
  if (name === "show_screen") return { ok: showScreen(String(a.screen), meEl) };
  if (name === "open_booking") { cta("Pick a time", BOOK, meEl, true); return { ok: true, note: "A Pick a time button is now in the chat." }; }
  if (name === "open_page") { pageLink(String(a.path || "/product"), meEl); return { ok: true }; }
  if (name === "save_lead") {
    const email = String(a.email || "").trim().toLowerCase();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return { ok: false, reason: "The email is not valid. Ask them to repeat it." };
    if (FREE.test(email) && !a.personal_email_confirmed) return { ok: false, reason: "Personal email. Ask once for a work email. If they prefer this one, call save_lead again with personal_email_confirmed true." };
    const lead = { name: String(a.name || ""), email, company: String(a.company || ""), interest: String(a.interest || ""), sector: String(a.sector || ""), regulators: String(a.regulators || "") };
    Object.assign(engine.lead, lead); if (a.notes) engine.lead.questions.push(String(a.notes));
    if (leadsOn) { leadSent = true; await sendLead(engine.lead, lines); return { ok: true, saved: true }; }
    cta("Send my details to the team", mailto(engine.lead), meEl);
    return { ok: true, saved: false, note: "A Send my details to the team button is now in the chat. Ask them to press it, which opens an email to the team." };
  }
  return { ok: false };
}
async function startLive(withMic: boolean) {
  const c = new LiveCall({
    state: (s: CallState, why?: string) => {
      if (s === "connecting") { stateEl.textContent = "Connecting"; big.state = "thinking"; }
      if (s === "ended") {
        if (call === c) { call = null; speakerOn = false; micOn = false; paint(); setState("idle"); }
        if (why === "time") bubble("v", "Our voice time is up for now. Switch the speaker on again to carry on talking, or keep typing.");
        else if (why === "error") bubble("v", "The voice connection dropped. Switch the speaker on to reconnect, or keep typing.");
      }
    },
    user: (t, done) => liveBubble("u", t, done),
    vigil: (t, done) => liveBubble("v", t, done),
    tool,
  });
  call = c;
  await c.start(location.pathname, lines, withMic);
  liveOk = true;
}

function paint() {
  spkBtn.setAttribute("aria-pressed", String(speakerOn)); spkBtn.querySelector("i")!.className = `ti ti-volume${speakerOn ? "" : "-off"}`;
  micBtn.setAttribute("aria-pressed", String(micOn)); micBtn.querySelector("i")!.className = `ti ti-microphone${micOn ? "" : "-off"}`;
  spkBtn.setAttribute("aria-label", speakerOn ? "Turn Vigil's voice off" : "Turn Vigil's voice on");
  micBtn.setAttribute("aria-label", micOn ? "Turn your microphone off" : "Turn your microphone on and talk");
}

async function setSpeaker(on: boolean) {
  if (on === speakerOn) return;
  speakerOn = on; paint();
  if (!on) { micOn = false; paint(); call?.end(); call = null; voice.stopSpeaking(); voice.stopListening(); listening = false; setState("idle"); return; }
  if (liveOk !== false) {
    try { await startLive(micOn); return; }
    catch (e) {
      call = null;
      const m = (e as Error).message;
      if (m === "busy") { bubble("v", "You have switched voice on a lot in a short time. Please type for now, or try again in a little while."); speakerOn = false; micOn = false; paint(); return; }
      if ((e as DOMException).name === "NotAllowedError") { micOn = false; paint(); bubble("v", "Your microphone is blocked, so I can talk but not hear you. Allow it in your browser, or type here."); return; }
      liveOk = false;
    }
  }
  // Backup: read the last answer, or greet, with the browser's voice.
  const lastV = [...lines].reverse().find((l) => l.who === "vigil");
  speakBackup(lines.length > 1 && lastV ? lastV.text : opener(location.pathname).text);
}

async function setMic(on: boolean) {
  if (on === micOn) return;
  micOn = on; paint();
  if (!on) { if (call) await call.setMic(false); voice.stopListening(); listening = false; return; }
  if (call) {
    try { await call.setMic(true); } catch { micOn = false; paint(); bubble("v", "Your microphone is blocked. Allow it in your browser and switch the mic on again, or type here."); }
    return;
  }
  if (!speakerOn) { await setSpeaker(true); if (call) return; }
  if (!call) listenBackup();
}

async function listenBackup() {
  if (!micOn || listening || call) return;
  if (!voice.canListen) { bubble("v", "This browser cannot take voice here. Chrome, Edge or Safari can, or you can type."); micOn = false; paint(); return; }
  listening = true; setState("listening");
  const p = bubble("p", "Listening");
  try {
    const said = fixNames(await voice.listen((t) => (p.textContent = fixNames(t) || "Listening")));
    p.remove(); listening = false;
    if (said) send(said); else setState("idle");
  } catch (e) {
    p.remove(); listening = false; micOn = false; paint(); setState("idle");
    if ((e as Error).message === "not-allowed") bubble("v", "Your microphone is blocked. Allow it in your browser, or type here.");
  }
}

// Open and close
function open(first = true) {
  shell.hidden = false; launch.hidden = true;
  big.resize();
  if (first && !log.children.length) { const o = opener(location.pathname); bubble("v", o.text); record("vigil", o.text); renderChips(o.chips); }
  setTimeout(() => text.focus(), 50); save(true);
}
function close() {
  setSpeaker(false);
  shell.hidden = true; launch.hidden = false; stage.hidden = true; save(false); launch.focus();
}

launch.addEventListener("click", () => open());
$("[data-va-close]").addEventListener("click", close);
$("[data-va-unstage]").addEventListener("click", () => (stage.hidden = true));
spkBtn.addEventListener("click", () => setSpeaker(!speakerOn));
micBtn.addEventListener("click", () => setMic(!micOn));
document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !shell.hidden) close(); });
form.addEventListener("submit", (e) => { e.preventDefault(); const v = text.value; text.value = ""; text.style.height = ""; send(v); });
text.addEventListener("keydown", (e) => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); } });
text.addEventListener("input", () => { text.style.height = ""; text.style.height = Math.min(110, text.scrollHeight) + "px"; });
document.addEventListener("click", (e) => {
  const t = (e.target as HTMLElement).closest<HTMLElement>("[data-ask]"); if (!t) return;
  e.preventDefault(); open(); send(t.dataset.ask || "");
});
addEventListener("pagehide", () => { if (leadSent) sendTranscript(engine.lead, lines); });

// Carry the conversation across pages
try {
  const sv: Saved | null = JSON.parse(sessionStorage.getItem(KEY) || "null");
  if (sv) {
    Object.assign(engine.lead, sv.lead, { page: location.pathname }); leadSent = sv.leadSent;
    sv.lines.forEach((l) => { bubble(l.who === "vigil" ? "v" : "u", l.text); lines.push(l); });
    if (sv.open) open(false);
  }
} catch {}
paint();
</script>
